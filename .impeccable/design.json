  "narrative": {
    "northStar": "The Product Stage",
    "overview": "The approved direction is an Apple product website-style presentation of real mini-program tools: large type, generous chapters, neutral surfaces, and clear green actions. The shared language supports two independent identities, weapp.dev and weapp.js.org. It borrows presentation principles, not Apple logos, proprietary fonts, product imagery, or private assets.\n\nWhite and light gray alternate with black and dark gray. The original particle wordmark and project planets remain the recognizable opening; real demos, project assets, source links, and release data carry the product explanation. Both applications default to dark when no valid saved theme exists, then honor the saved light or dark choice in `weapp-theme`. This is not system-theme selection. Core content is visible before JavaScript or entrance observers run.",
    "keyCharacteristics": [
      "Neutral light and dark surfaces with green primary actions",
      "Geist display and body typography with Chinese system fallbacks",
      "Large headlines, spacious chapters, wide demos, and quiet information rows",
      "Pill actions and circular icon controls; rounded media and floating panels",
      "Independent application identities sharing neutral UI primitives",
      "Restrained particle motion and default-visible, static-first content"
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Use green for primary actions and meaningful states; project marks and demo syntax retain their factual colors.",
        "section": "colors"
      },
      {
        "name": "The Honest Asset Rule",
        "body": "Use actual project assets and evidence. Do not introduce Apple assets or fabricate customer, release, or performance proof.",
        "section": "colors"
      },
      {
        "name": "The One Reading Voice Rule",
        "body": "Use Geist for headings, prose, navigation, and labels. Reserve Geist Mono for code, commands, versions, and numerical evidence.",
        "section": "typography"
      },
      {
        "name": "The Chapter Rule",
        "body": "Let headings, whitespace, broad demos, and information rows establish hierarchy; do not wrap every section in a card.",
        "section": "layout"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Use neutral tonal steps for content hierarchy and shadows for floating navigation or dialogs.",
        "section": "elevation"
      },
      {
        "name": "The Visible Content Rule",
