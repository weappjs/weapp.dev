  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared pill action with theme-aware contrast.",
      "html": "<button class=\"ds-btn-primary\">Browse projects</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:12px 24px;border:1px solid transparent;border-radius:999px;font-size:14px;font-weight:600;line-height:1.2;cursor:pointer;transition:background-color 200ms,color 200ms,transform 200ms;font-family:var(--font-sans,'Geist Variable','PingFang SC','Microsoft YaHei',system-ui,sans-serif);background:var(--accent,#0e7958);color:var(--accent-contrast,#fff);}.ds-btn-primary:hover{background:var(--accent-hover,#096646)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:3px solid var(--highlight,#f2c94c);outline-offset:3px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Shared pill action with theme-aware contrast.",
      "html": "<button class=\"ds-btn-secondary\">Browse projects</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:12px 24px;border:1px solid transparent;border-radius:999px;font-size:14px;font-weight:600;line-height:1.2;cursor:pointer;transition:background-color 200ms,color 200ms,transform 200ms;font-family:var(--font-sans,'Geist Variable','PingFang SC','Microsoft YaHei',system-ui,sans-serif);background:var(--surface-soft,#f5f5f7);color:var(--text,#1d1d1f);}.ds-btn-secondary:hover{background:var(--surface-strong,#e8e8ed)}.ds-btn-secondary:active{transform:translateY(1px)}.ds-btn-secondary:focus-visible{outline:3px solid var(--highlight,#f2c94c);outline-offset:3px}"
    },
    {
      "name": "Icon Control",
      "kind": "button",
      "refersTo": "icon-control",
      "description": "Circular control for navigation utilities.",
      "html": "<button class=\"ds-icon\" aria-label=\"Open project\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-icon{display:inline-grid;place-items:center;width:44px;height:44px;border:1px solid transparent;border-radius:999px;background:transparent;color:var(--muted,#626266);cursor:pointer;transition:background-color 200ms,color 200ms,transform 200ms}.ds-icon:hover{background:var(--surface-soft,#f5f5f7);color:var(--text,#1d1d1f)}.ds-icon:active{transform:translateY(1px)}.ds-icon:focus-visible{outline:3px solid var(--highlight,#f2c94c);outline-offset:3px}"
    },
    {
      "name": "Platform Pill",
      "kind": "chip",
      "refersTo": "platform-pill",
      "description": "Quiet supporting platform metadata.",
      "html": "<span class=\"ds-pill\">WeChat</span>",
      "css": ".ds-pill{display:inline-block;padding:6px 10px;border:1px solid var(--border,#d2d2d7);border-radius:999px;background:var(--surface,#fff);color:var(--muted,#626266);font-size:12px;font-family:var(--font-sans,'Geist Variable','PingFang SC','Microsoft YaHei',system-ui,sans-serif);}"
    },
    {
      "name": "Project Filter",
      "kind": "input",
      "description": "Native select from the project directory.",
      "html": "<label class=\"ds-filter\">Platform<select><option>All platforms</option><option>WeChat</option></select></label>",
      "css": ".ds-filter{display:grid;gap:6.4px;color:var(--muted,#626266);font-size:11.2px;font-weight:650;font-family:var(--font-sans,'Geist Variable','PingFang SC','Microsoft YaHei',system-ui,sans-serif);}.ds-filter select{min-width:160px;min-height:44px;padding:8px 10.4px;border:1px solid var(--border,#d2d2d7);border-radius:12px;background:var(--surface,#fff);color:var(--text,#1d1d1f);font-size:14.4px;font-family:var(--font-sans,'Geist Variable','PingFang SC','Microsoft YaHei',system-ui,sans-serif);}.ds-filter select:focus-visible{outline:3px solid var(--highlight,#f2c94c);outline-offset:3px}.ds-filter select:disabled{cursor:not-allowed;opacity:.65}"
    },
    {
      "name": "Project Navigation",
      "kind": "nav",
      "description": "Floating project navigation with a restrained shadow.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Projects\"><a href=\"#projects\">Browse projects</a><a href=\"#weapp-vite\">weapp-vite</a><a href=\"#weapp-tailwindcss\">weapp-tailwindcss</a></nav>",
      "css": ".ds-nav{display:grid;max-width:350px;padding:8px;border:1px solid var(--border,#d2d2d7);border-radius:20px;background:var(--surface,#fff);box-shadow:0 18px 48px var(--shadow,rgb(0 0 0 / 10%));font-family:var(--font-sans,'Geist Variable','PingFang SC','Microsoft YaHei',system-ui,sans-serif);}.ds-nav a{padding:12px;border-radius:12px;color:var(--text,#1d1d1f);font-size:14px;font-weight:650;text-decoration:none}.ds-nav a:first-child{color:var(--accent,#0e7958)}.ds-nav a:hover{background:var(--surface-soft,#f5f5f7)}.ds-nav a:focus-visible{outline:3px solid var(--highlight,#f2c94c);outline-offset:3px}"
    },
    {
      "name": "Demo Frame",
