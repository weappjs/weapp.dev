      "css": ".ds-demo{overflow:hidden;border:1px solid var(--border,#d2d2d7);border-radius:20px;background:var(--surface,#fff);color:var(--text,#1d1d1f);font-family:var(--font-sans,'Geist Variable','PingFang SC','Microsoft YaHei',system-ui,sans-serif);}.ds-demo header{min-height:52px;padding:12px 16px;border-bottom:1px solid var(--border,#d2d2d7);font-size:14px;font-weight:600}.ds-demo pre{margin:0;padding:24px;font:400 12px/1.7 var(--font-mono,ui-monospace,monospace)}"
    }
