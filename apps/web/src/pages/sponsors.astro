---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { getProjects } from '../lib/projects'
import { getSiteProfile } from '../lib/deployment'
import { sponsorsSchema } from '../lib/seo'

const locale = 'zh-CN' as const
const profile = getSiteProfile()
const projects = await getProjects()
const Content = (await import('../components/SponsorsPage.astro')).default
const title = '赞助图谱'
const description = '公开赞助、项目维护与贡献者基金图谱。'
---

<BaseLayout locale={locale} title={`${title} | ${profile.name}`} description={description} imageAlt={`${profile.name} ${title}`} schemas={[sponsorsSchema(locale)]}>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <Content locale={locale} />
  <Footer locale={locale} projects={projects} currentPath={Astro.url.pathname} />
</BaseLayout>
