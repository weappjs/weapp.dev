---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import PricingPage from '../../components/PricingPage.astro'
import Footer from '../../components/Footer.astro'
import { getProjects } from '../../lib/projects'
import { pricingSchema } from '../../lib/seo'
import { isGithubPagesBuild } from '../../lib/deployment'

const locale = 'en' as const
const projects = await getProjects()
const title = 'Sponsorship and fund splits | weapp.dev'
const githubPages = isGithubPagesBuild()
const description = githubPages ? 'Sponsorship tiers, the 60/25/15 fund split, and the weapp.dev contributors fund.' : 'Sponsorship tiers, the 60/25/15 fund split, and deliverable migration and training services from weapp.dev.'
---

<BaseLayout locale={locale} title={title} description={description} imageAlt={githubPages ? 'weapp.dev open-source sponsorship and contributors fund' : 'weapp.dev commercial delivery layer'} schemas={[pricingSchema(locale, githubPages)]}>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <PricingPage locale={locale} />
  <Footer locale={locale} projects={projects} currentPath={Astro.url.pathname} />
</BaseLayout>
