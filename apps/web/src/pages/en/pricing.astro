---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import { getProjects } from '../../lib/projects'
import { getSiteProfile } from '../../lib/deployment'
import { pricingSchema } from '../../lib/seo'

const locale = 'en' as const
const profile = getSiteProfile()
const projects = await getProjects()
const Content = (await import('../../components/PricingPage.astro')).default
const title = 'Migration, training and open-source sponsorship'
const description = 'Mini-program migration and training services, with separate sponsorship for open-source maintenance, documentation, and contributors.'
---

<BaseLayout locale={locale} title={`${title} | ${profile.name}`} description={description} imageAlt={`${profile.name} ${title}`} schemas={[pricingSchema(locale)]}>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <Content locale={locale} />
  <Footer locale={locale} projects={projects} currentPath={Astro.url.pathname} />
</BaseLayout>
