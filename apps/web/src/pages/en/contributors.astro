---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import { getProjects } from '../../lib/projects'
import { getSiteProfile } from '../../lib/deployment'
import { contributorsSchema } from '../../lib/seo'

const locale = 'en' as const
const profile = getSiteProfile()
const projects = await getProjects()
const Content = (await import('../../components/ContributorsPage.astro')).default
const title = 'Contributor program'
const description = 'Learn about open-source contributions, the contributors fund, and public allocation rules.'
---

<BaseLayout locale={locale} title={`${title} | ${profile.name}`} description={description} imageAlt={`${profile.name} ${title}`} schemas={[contributorsSchema(locale, title, description)]}>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <Content locale={locale} />
  <Footer locale={locale} projects={projects} currentPath={Astro.url.pathname} />
</BaseLayout>
