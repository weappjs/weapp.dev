---
import { getSiteProfile } from '../../lib/deployment'
import BaseLayout from '../../layouts/BaseLayout.astro'
import HeroFont from '@weapp-io/site-ui/HeroFont.astro'
import Header from '../../components/Header.astro'
import HomePage from '../../components/HomePage.astro'
import Footer from '../../components/Footer.astro'
import { getProjects } from '../../lib/projects'
import { loadProjectMetrics } from '../../lib/metrics'
import { getHomeProjects } from '../../lib/home'
import { organizationSchema, projectListSchema, websiteSchema } from '../../lib/seo'

const profile = getSiteProfile()
const locale = 'en' as const
const projects = await getProjects()
const metrics = await loadProjectMetrics()
const homeProjects = await getHomeProjects(projects)
const title = `${profile.name} | Mini-app tools and engineering services`
const description = 'Compose engineering, styling, components, and local data with the weapp toolchain, then connect it to real repositories through migration, training, and template work.'
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  imageAlt={`${profile.name} toolchain map for mini-app engineering`}
  schemas={[organizationSchema(), websiteSchema(locale), projectListSchema(locale, projects)]}
>
  <HeroFont slot="head" />
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <HomePage locale={locale} projects={projects} metrics={metrics} homeProjects={homeProjects} />
  <Footer locale={locale} projects={projects} currentPath={Astro.url.pathname} />
</BaseLayout>
