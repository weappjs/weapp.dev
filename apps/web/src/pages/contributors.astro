---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ProjectRedirect from '../components/ProjectRedirect.astro'
import { getProjects } from '../lib/projects'
import { getSiteProfile } from '../lib/deployment'
import { contributorsSchema } from '../lib/seo'

const locale = 'zh-CN' as const
const profile = getSiteProfile()
const projects = profile.features.sponsorship ? await getProjects() : []
const Content = profile.features.sponsorship ? (await import('../components/ContributorsPage.astro')).default : ProjectRedirect
const title = '贡献者计划'
const description = '了解开源贡献、贡献者基金与公开分配规则。'
---

{profile.features.sponsorship ? <BaseLayout locale={locale} title={`${title} | ${profile.name}`} description={description} imageAlt={`${profile.name} ${title}`} schemas={[contributorsSchema(locale, title, description)]}>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <Content locale={locale} />
  <Footer locale={locale} projects={projects} currentPath={Astro.url.pathname} />
</BaseLayout> : <ProjectRedirect locale={locale} />}
