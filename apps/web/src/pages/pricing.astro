---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ProjectRedirect from '../components/ProjectRedirect.astro'
import { getProjects } from '../lib/projects'
import { getSiteProfile } from '../lib/deployment'
import { pricingSchema } from '../lib/seo'

const locale = 'zh-CN' as const
const profile = getSiteProfile()
const projects = profile.features.sponsorship ? await getProjects() : []
const Content = profile.features.sponsorship ? (await import('../components/PricingPage.astro')).default : ProjectRedirect
const title = '迁移、培训与开源赞助'
const description = '小程序工程迁移与培训服务，以及支持维护、文档和贡献者的开源赞助。'
---

{profile.features.sponsorship ? <BaseLayout locale={locale} title={`${title} | ${profile.name}`} description={description} imageAlt={`${profile.name} ${title}`} schemas={[pricingSchema(locale)]}>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <Content locale={locale} />
  <Footer locale={locale} projects={projects} currentPath={Astro.url.pathname} />
</BaseLayout> : <ProjectRedirect locale={locale} />}
