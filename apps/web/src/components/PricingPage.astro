---
import { ArrowRight, Check, Cloud, ExternalLink, GitFork, Heart, Layers2, LockKeyhole, ShieldCheck } from '@lucide/astro'
import type { Locale } from '../types/project'
import { localizePath, siteCopy } from '../i18n/ui'
import { isGithubPagesBuild } from '../lib/deployment'
import { filterOpenSourceSponsors, isOpenSourceSponsorTier, loadPublicSponsors } from '../lib/sponsors'
import { buttonPrimary, buttonSecondary, section, shell } from '../styles/classes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = siteCopy[locale]
const pricing = copy.pricing
const githubPages = isGithubPagesBuild()
const sponsorSnapshot = await loadPublicSponsors()
const publicSponsors = (githubPages ? filterOpenSourceSponsors(sponsorSnapshot) : sponsorSnapshot).items
const githubUrl = 'https://github.com/sonofmagic/weapp.dev'
const planIcons = [Layers2, Cloud, LockKeyhole, ShieldCheck]
const hero = githubPages
  ? locale === 'zh-CN'
    ? { eyebrow: '开源赞助', title: '支持工具链继续开源', description: '通过公开赞助支持 weapp.dev 的维护、文档、测试和贡献者基金。', early: '赞助用于支持开源维护和贡献者基金。', ctaTitle: '让开源项目有继续维护的预算', ctaBody: '通过 GitHub 查看开源赞助方式和公开记录。', ctaAction: '在 GitHub 了解方式' }
    : { eyebrow: 'Open-source sponsorship', title: 'Keep the toolchain open', description: 'Support weapp.dev maintenance, documentation, testing, and the contributors fund through public sponsorship.', early: 'Sponsorship supports open-source maintenance and the contributors fund.', ctaTitle: 'Give open source a budget to keep going', ctaBody: 'Use GitHub to see sponsorship details and public records.', ctaAction: 'Learn how on GitHub' }
  : { eyebrow: pricing.eyebrow, title: pricing.title, description: pricing.description, early: pricing.early, ctaTitle: pricing.ctaTitle, ctaBody: pricing.ctaBody, ctaAction: pricing.ctaAction }
const sponsorNote = githubPages
  ? locale === 'zh-CN'
    ? '赞助用于开源维护、文档、测试和贡献者基金。公开展示需完成 GitHub 身份确认、维护者审核和明确授权。'
    : 'Sponsorship supports open-source maintenance, documentation, testing, and the contributors fund. Public display requires GitHub identity confirmation, maintainer review, and explicit authorization.'
  : pricing.sponsorNote
const sponsorDescription = githubPages
  ? locale === 'zh-CN'
    ? '通过一次性赞助支持 weapp.dev 的维护、文档、测试和贡献者基金。'
    : 'Support weapp.dev maintenance, documentation, testing, and the contributors fund through one-time sponsorship.'
  : pricing.sponsorDescription
const sponsorSites = githubPages
  ? locale === 'zh-CN' ? '公开名单（仅展示已确认并授权的 GitHub 信息）' : 'Public recognition (confirmed and authorized GitHub details only)'
  : pricing.sponsorSites
---

<main id="main-content">
  <section class="pricing-hero">
    <div class:list={[shell, 'pricing-hero-inner']}>
      <div data-reveal>
        <p class="mb-4 font-mono text-xs font-[650] uppercase tracking-[0.12em] text-brand">{hero.eyebrow}</p>
        <h1 class="mb-6 max-w-[780px] text-[64px] font-[740] leading-[1.15] max-[1000px]:text-[52px] max-[720px]:text-[36px]">{hero.title}</h1>
        <p class="mb-8 max-w-[650px] text-xl leading-[1.5] text-copy-muted max-[720px]:text-base">{hero.description}</p>
        <div class="flex flex-wrap items-center gap-3">
          <a class={buttonPrimary} href={githubUrl} target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="pricing_github">
            <GitFork size={18} stroke-width={1.9} aria-hidden="true" />
            {hero.ctaAction}
          </a>
          <a class={buttonSecondary} href={`${localizePath(locale)}#projects`} data-analytics-event="navigate_section" data-analytics-section="pricing_projects">
            {locale === 'zh-CN' ? '先看开源项目' : 'Explore open source'}
            <ArrowRight size={17} stroke-width={1.9} aria-hidden="true" />
          </a>
        </div>
      </div>
      <aside class="pricing-hero-note" data-reveal style="--reveal-delay: 120ms">
        <span class="pricing-note-line" aria-hidden="true"></span>
        <p>{hero.early}</p>
      </aside>
    </div>
  </section>

  {!githubPages && <>
  <section class:list={[section, shell]} id="plans">
    <header data-reveal class="mb-12 max-w-[700px]">
      <p class="mb-3 font-mono text-xs font-[650] text-brand">01 / {locale === 'zh-CN' ? '产品货架' : 'PRODUCT SHELF'}</p>
      <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{locale === 'zh-CN' ? '从一次试用，到一套可复现的交付' : 'From one trial to a reproducible delivery path'}</h2>
    </header>
    <div class="pricing-plan-grid">
      {pricing.plans.map((plan, index) => {
        const Icon = planIcons[index]
        return (
          <article data-reveal class:list={['pricing-plan', plan.featured ? 'pricing-plan-featured' : '']} style={`--reveal-delay: ${index * 60}ms`}>
            <div class="mb-8 flex items-center justify-between">
              <Icon class="text-brand" size={24} stroke-width={1.7} aria-hidden="true" />
              <span class:list={['pricing-plan-badge', plan.status === 'planned' ? 'pricing-plan-status-planned' : '']}>{plan.status === 'planned' ? (locale === 'zh-CN' ? '规划中' : 'PLANNED') : (locale === 'zh-CN' ? '现在可用' : 'AVAILABLE')}</span>
            </div>
            <h3 class="mb-2 text-2xl font-[680]">{plan.name}</h3>
            <p class="mb-6 min-h-12 text-sm leading-[1.65] text-copy-muted">{plan.description}</p>
            <div class="mb-7 border-y border-line py-4">
              <strong class="block font-mono text-[2rem] font-[720] leading-none">{plan.price}</strong>
              <span class="mt-2 block text-xs text-copy-muted">{plan.cadence}</span>
            </div>
            <ul class="m-0 mb-8 grid min-h-[184px] list-none gap-3 p-0 text-sm">
              {plan.features.map(feature => <li class="flex items-start gap-2"><Check class="mt-0.5 shrink-0 text-brand" size={15} stroke-width={2} aria-hidden="true" /><span>{feature}</span></li>)}
            </ul>
            <a class:list={[plan.featured ? buttonPrimary : buttonSecondary, 'w-full']} href={githubUrl} target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target={`pricing_${plan.name.toLowerCase()}`}>
              {plan.action}
              <ExternalLink size={16} stroke-width={1.8} aria-hidden="true" />
            </a>
          </article>
        )
      })}
    </div>
  </section>
  </>}

  <section class="border-y border-line bg-panel-soft" id="sponsor">
    <div class:list={[section, shell]}>
      <header data-reveal class="mb-12 max-w-[720px]">
        <p class="mb-3 font-mono text-xs font-[650] text-brand">01A / {locale === 'zh-CN' ? '开源赞助' : 'OPEN-SOURCE SPONSORSHIP'}</p>
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{pricing.sponsorTitle}</h2>
        <p class="mb-0 max-w-[650px] text-lg text-copy-muted max-[720px]:text-base">{sponsorDescription}</p>
      </header>
      <div class="pricing-sponsor-grid" style={githubPages ? "--sponsor-columns: 3" : undefined}>
        {pricing.sponsorTiers.filter(tier => !githubPages || isOpenSourceSponsorTier(tier.id)).map((tier, index) => (
          <article data-reveal class="pricing-sponsor-tier" style={`--reveal-delay: ${index * 70}ms`}>
            <Heart class="mb-8 text-brand" size={23} stroke-width={1.7} aria-hidden="true" />
            <h3 class="mb-2 text-xl font-[660]">{tier.name}</h3>
            <strong class="mb-1 block font-mono text-[2rem] font-[720] leading-none">{tier.price}</strong>
            <span class="mb-5 block text-xs text-copy-muted">{tier.cadence}</span>
            <p class="mb-7 min-h-12 text-sm leading-[1.7] text-copy-muted">{tier.body}</p>
            <a class:list={['pricing-sponsor-button', buttonSecondary]} href={githubUrl} target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target={`sponsor_${index + 1}`}>
              {pricing.sponsorAction}
              <ExternalLink size={16} stroke-width={1.8} aria-hidden="true" />
            </a>
          </article>
        ))}
      </div>
      <div data-reveal class="pricing-sponsor-allocation">
        <p class="mb-2 font-[650]">{locale === 'zh-CN' ? '资金去向' : 'Where it goes'}</p>
        {githubPages ? <>
          <ul class="m-0 grid list-none gap-3 p-0 text-sm leading-[1.7] text-copy-muted">
            {pricing.sponsorAllocationBuckets.map(bucket => <li><strong class="text-ink">{bucket.share} {bucket.name}</strong> · {bucket.body}</li>)}
          </ul>
          <div class="mt-5 flex flex-wrap gap-4">
            <a class="text-sm font-[650] text-brand underline underline-offset-4" href={localizePath(locale, '/contributors/')}>{locale === 'zh-CN' ? '了解贡献者基金' : 'Explore the contributors fund'}</a>
            <a class="text-sm font-[650] text-brand underline underline-offset-4" href={localizePath(locale, '/sponsors/')}>{locale === 'zh-CN' ? '查看赞助图谱' : 'View the sponsor graph'}</a>
          </div>
        </> : <p class="mb-0 text-sm leading-[1.7] text-copy-muted">{pricing.sponsorAllocation}</p>}
      </div>
      <p data-reveal class="mt-5 mb-0 text-xs text-copy-muted">{sponsorNote}</p>
      <div data-reveal class="pricing-public-sponsors">
        <h3 class="mb-2 text-lg font-[660]">{sponsorSites}</h3>
        {publicSponsors.length === 0 ? <p class="mb-0 text-sm text-copy-muted">{pricing.sponsorEmpty}</p> : <div class="pricing-public-sponsor-list">
          {(['gold', 'silver', 'bronze', 'supporter'] as const).map(tier => {
            const sponsors = publicSponsors.filter(sponsor => sponsor.tier === tier)
            if (!sponsors.length) return null
            return <div class="pricing-public-sponsor-group">
              <p class="mb-3 font-mono text-xs font-[650] uppercase text-brand">{tier}</p>
              <ul class="m-0 flex flex-wrap gap-3 p-0 list-none">
                {sponsors.map(sponsor => <li><a class="pricing-public-sponsor" href={sponsor.kind === 'business' ? sponsor.brandUrl : sponsor.profileUrl} target="_blank" rel="noreferrer">
                  {sponsor.avatarUrl || sponsor.logoUrl ? <img src={sponsor.avatarUrl || sponsor.logoUrl} alt="" width="32" height="32" loading="lazy" /> : <span class="pricing-public-sponsor-fallback" aria-hidden="true">{(sponsor.brandName || sponsor.login || '?').slice(0, 1).toUpperCase()}</span>}
                  <span>{sponsor.brandName || sponsor.login}</span><ExternalLink size={14} stroke-width={1.8} aria-hidden="true" />
                </a></li>)}
              </ul>
            </div>
          })}
        </div>}
      </div>
    </div>
  </section>

  {!githubPages && <>
  <section class="border-y border-line bg-panel-soft" id="roadmap">
    <div class:list={[section, shell]}>
      <header data-reveal class="mb-12 max-w-[700px]">
        <p class="mb-3 font-mono text-xs font-[650] text-brand">02 / {locale === 'zh-CN' ? '建设中的能力' : 'ROADMAP'}</p>
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{pricing.roadmapTitle}</h2>
        <p class="mb-4 text-lg text-copy-muted max-[720px]:text-base">{pricing.roadmapDescription}</p>
        <h3 class="mb-3 text-xl font-[660]">{pricing.templatesTitle}</h3>
        <p class="mb-0 text-lg text-copy-muted max-[720px]:text-base">{pricing.templatesDescription}</p>
      </header>
      <div class="pricing-template-grid">
        {pricing.templates.map((template, index) => (
          <article data-reveal class="pricing-template" style={`--reveal-delay: ${index * 45}ms`}>
            <span class="pricing-template-index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="mb-2 text-xl font-[660]">{template.name}</h3>
              <p class="mb-1 text-xs font-[650] text-brand">{template.category}</p>
              <p class="mb-0 text-sm text-copy-muted">{template.pages}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class:list={[section, shell]} id="cloud-build">
    <div class="grid grid-cols-[.76fr_1.24fr] gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-10">
      <header data-reveal class="max-w-[470px]">
        <p class="mb-3 font-mono text-xs font-[650] text-brand">03 / {locale === 'zh-CN' ? '云构建' : 'CLOUD BUILDS'}</p>
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{pricing.buildTitle}</h2>
        <p class="mb-0 text-copy-muted">{pricing.buildDescription}</p>
      </header>
      <ol class="pricing-build-path m-0 list-none p-0">
        {pricing.buildSteps.map((step, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <span class="pricing-build-number">{String(index + 1).padStart(2, '0')}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-y border-line bg-panel" id="services">
    <div class:list={[section, shell]}>
      <header data-reveal class="mb-12 max-w-[700px]">
        <p class="mb-3 font-mono text-xs font-[650] text-brand">04 / {locale === 'zh-CN' ? '实施服务' : 'SERVICES'}</p>
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{pricing.servicesTitle}</h2>
      </header>
      <div class="pricing-service-list">
        {pricing.services.map((service, index) => (
          <article data-reveal style={`--reveal-delay: ${index * 60}ms`}>
            <span class="pricing-service-index">{String(index + 1).padStart(2, '0')}</span>
            <div><h3 class="mb-2 text-lg font-[660]">{service.name}</h3><p class="mb-0 text-sm text-copy-muted">{service.body}</p></div>
            <strong class="font-mono text-sm font-[700] max-[620px]:col-start-2">{service.price}</strong>
          </article>
        ))}
      </div>
      <p class="mt-7 mb-0 max-w-[720px] text-xs leading-[1.7] text-copy-muted">{locale === 'zh-CN' ? '服务只围绕工具链交付，不承接与产品无关的业务外包。服务收入连续两个月超过总收入 50% 时，将停止接收新单。' : 'Services stay tied to the toolchain and do not become unrelated product outsourcing. New work pauses if services exceed 50% of total revenue for two consecutive months.'}</p>
    </div>
  </section>

  <section class:list={[section, shell]} id="support">
    <div class="grid grid-cols-[.72fr_1.28fr] gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-10">
      <header data-reveal class="max-w-[470px]"><p class="mb-3 font-mono text-xs font-[650] text-brand">05 / {locale === 'zh-CN' ? '支持边界' : 'SUPPORT'}</p><h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{pricing.slaTitle}</h2></header>
      <div data-reveal class="overflow-x-auto border-t border-line">
        <table class="pricing-sla-table w-full border-collapse text-left text-sm"><thead><tr><th>{locale === 'zh-CN' ? '层级' : 'Tier'}</th><th>{locale === 'zh-CN' ? '渠道' : 'Channel'}</th><th>{locale === 'zh-CN' ? '响应' : 'Response'}</th></tr></thead><tbody>{pricing.slaRows.map(row => <tr><th scope="row">{row.name}</th><td>{row.channel}</td><td>{row.response}</td></tr>)}</tbody></table>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-panel-soft" id="boundary">
    <div class:list={[section, shell]}>
      <header data-reveal class="mb-12 max-w-[700px]"><p class="mb-3 font-mono text-xs font-[650] text-brand">06 / {locale === 'zh-CN' ? '开源边界' : 'OPEN-SOURCE BOUNDARY'}</p><h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{pricing.boundaryTitle}</h2></header>
      <div class="pricing-boundary-grid">{pricing.boundary.map((item, index) => <article data-reveal style={`--reveal-delay: ${index * 70}ms`}><span class="pricing-boundary-mark" aria-hidden="true">{index === 0 ? '+' : index === 1 ? '$' : 'x'}</span><h3 class="mb-2 text-xl font-[660]">{item.label}</h3><p class="mb-0 text-sm leading-[1.7] text-copy-muted">{item.body}</p></article>)}</div>
    </div>
  </section>

  <section class:list={[section, shell]} id="faq">
    <div class="grid grid-cols-[.72fr_1.28fr] gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-10">
      <header data-reveal class="max-w-[470px]"><p class="mb-3 font-mono text-xs font-[650] text-brand">07 / FAQ</p><h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{pricing.faqTitle}</h2></header>
      <div data-reveal class="border-t border-line">{pricing.faq.map(item => <details class="border-b border-line py-5"><summary class="cursor-pointer list-none pr-8 text-lg font-[650] [&::-webkit-details-marker]:hidden">{item.question}</summary><p class="mt-3 mb-0 max-w-[650px] text-sm leading-[1.7] text-copy-muted">{item.answer}</p></details>)}</div>
    </div>
  </section>

  </>}

  <section class="pricing-cta border-t border-line bg-panel-soft">
    <div data-reveal class:list={[shell, 'grid min-h-[300px] grid-cols-[1fr_auto] items-center gap-10 py-16 max-[720px]:grid-cols-1 max-[720px]:py-14']}>
      <div><h2 class="mb-3 max-w-[700px] text-[38px] font-[680] max-[720px]:text-[30px]">{hero.ctaTitle}</h2><p class="mb-0 max-w-[650px] text-copy-muted">{hero.ctaBody}</p></div>
      <a class={buttonPrimary} href={githubUrl} target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="pricing_cta"><GitFork size={18} stroke-width={1.9} aria-hidden="true" />{hero.ctaAction}</a>
    </div>
  </section>
</main>

<style is:global>
  .pricing-hero { background: var(--background); color: var(--text); }
  .pricing-hero-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, .42fr); gap: 4rem; align-items: end; min-height: 520px; padding-top: 5rem; padding-bottom: 5rem; }
  .pricing-hero-note { display: flex; gap: 1rem; align-items: flex-start; max-width: 290px; padding-bottom: .5rem; color: var(--muted); font-size: .86rem; }
  .pricing-note-line { width: 2.5rem; height: 1px; margin-top: .7rem; flex: 0 0 auto; background: var(--accent); }
  .pricing-plan-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; overflow: hidden; border: 1px solid var(--border); background: var(--border); }
  .pricing-plan { display: flex; flex-direction: column; min-width: 0; padding: 1.75rem; background: var(--surface); }
  .pricing-plan-featured { background: color-mix(in srgb, var(--accent) 9%, var(--surface)); }
  .pricing-plan-badge { padding: .32rem .5rem; border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border)); color: var(--accent); font: 650 .6rem/1 var(--font-mono); letter-spacing: .04em; }
  .pricing-plan-status-planned { color: var(--muted); border-color: var(--border); }
  .pricing-sponsor-grid { display: grid; grid-template-columns: repeat(var(--sponsor-columns, 4), minmax(0, 1fr)); gap: 1px; overflow: hidden; border: 1px solid var(--border); background: var(--border); }
  .pricing-sponsor-tier { display: flex; flex-direction: column; min-width: 0; min-height: 280px; padding: 1.75rem; background: var(--surface); }
  .pricing-sponsor-button { margin-top: auto; width: fit-content; }
  .pricing-sponsor-allocation { max-width: 760px; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .pricing-public-sponsors { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .pricing-public-sponsor-list { display: grid; gap: 1.25rem; }
  .pricing-public-sponsor-group ul { display: flex; flex-wrap: wrap; gap: .75rem; }
  .pricing-public-sponsor { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.5rem; padding: .35rem .65rem .35rem .35rem; border: 1px solid var(--border); color: var(--text); font-size: .85rem; }
  .pricing-public-sponsor:hover { background: var(--surface); }
  .pricing-public-sponsor img, .pricing-public-sponsor-fallback { width: 2rem; height: 2rem; border-radius: 999px; object-fit: cover; background: color-mix(in srgb, var(--accent) 30%, transparent); display: grid; place-items: center; font: 650 .8rem/1 var(--font-mono); }
  .pricing-template-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; overflow: hidden; border: 1px solid var(--border); background: var(--border); }
  .pricing-template { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; min-height: 170px; padding: 1.5rem; background: var(--surface); }
  .pricing-template-index, .pricing-service-index { color: var(--accent); font: 650 .7rem/1 var(--font-mono); }
  .pricing-build-path { border-top: 1px solid var(--border); }
  .pricing-build-path li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; align-items: center; min-height: 82px; border-bottom: 1px solid var(--border); font-size: 1.1rem; font-weight: 620; }
  .pricing-build-number { color: var(--accent); font: 650 .7rem/1 var(--font-mono); }
  .pricing-service-list { border-top: 1px solid var(--border); }
  .pricing-service-list article { display: grid; grid-template-columns: 2rem 1fr auto; gap: 1rem; align-items: center; min-height: 104px; border-bottom: 1px solid var(--border); }
  .pricing-sla-table th, .pricing-sla-table td { padding: 1rem .75rem 1rem 0; border-bottom: 1px solid var(--border); vertical-align: top; }
  .pricing-sla-table thead { color: var(--muted); font: 650 .68rem/1.2 var(--font-mono); text-transform: uppercase; }
  .pricing-sla-table tbody th { font-weight: 650; }
  .pricing-boundary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; overflow: hidden; border: 1px solid var(--border); background: var(--border); }
  .pricing-boundary-grid article { min-height: 210px; padding: 1.75rem; background: var(--surface); }
  .pricing-boundary-mark { display: grid; place-items: center; width: 2rem; height: 2rem; margin-bottom: 2.3rem; border: 1px solid var(--accent); color: var(--accent); font: 650 1rem/1 var(--font-mono); }
  .pricing-cta .button-primary { background: var(--accent); color: var(--accent-contrast); }
  @media (max-width: 1000px) { .pricing-plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 1000px) { .pricing-sponsor-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
