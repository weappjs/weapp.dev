---
import { ArrowRight, ArrowUpRight, GitFork, Heart, Layers2, Package, ScanLine, ShieldCheck, BadgeCheck } from '@lucide/astro'
import type { Locale, ProjectMetricsMap } from '../types/project'
import type { ProjectEntry } from '../lib/projects'
import { formatReleaseDate } from '../lib/metrics'
import { localizePath, siteCopy } from '../i18n/ui'
import { buttonPrimary, buttonSecondary, iconControl, section, shell } from '../styles/classes'
import BuildRail from './BuildRail.astro'
import HomeHero from './home/HomeHero.astro'
import type { HomeProject } from '../lib/home-projects'
import { getCatalogEcosystemGroups, getConstellationProjects } from '../lib/toolchain'
import HomePartnerSection from './home/HomePartnerSection.astro'
import HomeProjects from './home/HomeProjects.astro'
import ToolchainMap from './ToolchainMap.astro'

interface Props {
  locale: Locale
  projects: ProjectEntry[]
  metrics: ProjectMetricsMap
  homeProjects?: HomeProject[]
}

const { locale, projects, metrics, homeProjects = [] } = Astro.props
const copy = siteCopy[locale]
const numberLocale = locale === 'zh-CN' ? 'zh-CN' : 'en-US'
const ecosystemGroups = getCatalogEcosystemGroups(projects)
const weappHome = homeProjects.filter(project => project.data.ecosystem === 'weapp')
const taroHome = homeProjects.filter(project => project.data.ecosystem === 'taro')
const constellation = getConstellationProjects(projects).map(project => ({
  id: project.id,
  href: project.data.docsUrl,
  logo: project.data.logo,
  name: project.data.locales[locale].name,
  accent: project.data.accent,
}))
const stageById = new Map(homeProjects.map(project => [project.id, project.stage]))
const railGroups = ecosystemGroups.map(group => ({
  id: group.id,
  label: copy.rail[group.id],
  projects: group.projects.map(project => ({
    id: project.id,
    data: project.data,
    stage: stageById.get(project.id) ?? { 'zh-CN': copy.rail[group.id], en: copy.rail[group.id] },
  })),
}))
const releaseProjects = projects.filter(project => metrics[project.id])
const stepIcons = [Layers2, ScanLine, Package]
const principleIcons = [Layers2, ShieldCheck, BadgeCheck]
---

<main id="main-content">
  <HomeHero locale={locale} railGroups={railGroups} constellation={constellation} />

  <section class="border-y border-line bg-panel" id="about">
    <div class:list={[section, shell]}>
      <header data-reveal class="mb-12 max-w-[720px]">
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{copy.about.title}</h2>
        <p class="mb-0 text-lg text-copy-muted max-[720px]:text-base">{copy.about.description}</p>
      </header>
      <ol class="m-0 grid list-none grid-cols-3 gap-0 border-y border-line p-0 max-[720px]:grid-cols-1 max-[720px]:border-b-0">
        {copy.about.items.map((item, index) => {
          const Icon = stepIcons[index]
          return (
            <li data-reveal style={`--reveal-delay: ${index * 70}ms`} class="relative min-h-[230px] border-r border-line px-7 py-8 last:border-r-0 max-[720px]:min-h-0 max-[720px]:border-r-0 max-[720px]:border-b max-[720px]:px-0">
              <div class="mb-10 flex items-center justify-between">
                <Icon class="text-brand" size={25} stroke-width={1.65} aria-hidden="true" />
              </div>
              <h3 class="mb-3 text-2xl font-[660]">{item.title}</h3>
              <p class="mb-0 max-w-[340px] text-copy-muted">{item.body}</p>
            </li>
          )
        })}
      </ol>
    </div>
  </section>

  <HomeProjects locale={locale} projects={weappHome} metrics={metrics} labProjects={homeProjects} pack="start" id="projects" eyebrow={copy.ecosystems.weapp.eyebrow} title={copy.ecosystems.weapp.title} description={copy.ecosystems.weapp.description} />

  <HomeProjects locale={locale} projects={taroHome} metrics={metrics} pack="middle" id="ecosystem-taro" eyebrow={copy.ecosystems.taro.eyebrow} title={copy.ecosystems.taro.title} description={copy.ecosystems.taro.description} />

  <HomePartnerSection locale={locale} pack="middle" id="ecosystem-vue-mini" projects={ecosystemGroups.find(group => group.id === 'vue-mini')?.projects ?? []} eyebrow={copy.ecosystems['vue-mini'].eyebrow} title={copy.ecosystems['vue-mini'].title} description={copy.ecosystems['vue-mini'].description} />

  <HomePartnerSection locale={locale} pack="middle" id="ecosystem-rezor" projects={ecosystemGroups.find(group => group.id === 'rezor')?.projects ?? []} eyebrow={copy.ecosystems.rezor.eyebrow} title={copy.ecosystems.rezor.title} description={copy.ecosystems.rezor.description} />

  <HomePartnerSection locale={locale} pack="end" id="ecosystem" projects={ecosystemGroups.find(group => group.id === 'uni-app')?.projects ?? []} eyebrow={copy.ecosystems['uni-app'].eyebrow} title={copy.ecosystems['uni-app'].title} description={copy.ecosystems['uni-app'].description} />

  <section class:list={[section, shell]} aria-label={locale === 'zh-CN' ? '工具链地图' : 'Toolchain map'}>
    <ToolchainMap locale={locale} projects={projects} />
  </section>

  <BuildRail locale={locale} />

  <section class="border-y border-line bg-panel-soft" id="commercial">
    <div class:list={[section, shell]}>
      <header data-reveal class="mb-12 max-w-[720px]">
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{copy.commercial.title}</h2>
        <p class="mb-0 text-lg text-copy-muted max-[720px]:text-base">{copy.commercial.description}</p>
      </header>
      <div class="grid grid-cols-3 gap-px overflow-hidden border border-line bg-line max-[760px]:grid-cols-1">
        {copy.commercial.cards.map((card, index) => (
          <article data-reveal style={`--reveal-delay: ${index * 70}ms`} class="bg-panel p-7">
            <h3 class="mb-3 text-2xl font-[660]">{card.title}</h3>
            <p class="mb-0 text-sm leading-[1.7] text-copy-muted">{card.body}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a class={buttonPrimary} href={`${localizePath(locale, '/pricing/')}#sponsor`} data-analytics-event="navigate_section" data-analytics-section="sponsor">{copy.commercial.trial}<Heart size={17} stroke-width={1.9} aria-hidden="true" /></a>
        <a class={buttonSecondary} href={`${localizePath(locale, '/pricing/')}#services`} data-analytics-event="navigate_section" data-analytics-section="services"><ArrowRight size={17} stroke-width={1.9} aria-hidden="true" />{copy.commercial.services}</a>
        <a class="inline-flex min-h-11 items-center gap-2 px-2 text-sm font-[650] text-copy-muted transition-colors hover:text-ink" href={`${localizePath(locale, '/pricing/')}#roadmap`} data-analytics-event="navigate_section" data-analytics-section="roadmap">{copy.commercial.pricing}<ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-panel-soft" id="vision">
    <span id="principles" class="sr-only" aria-hidden="true"></span>
    <div class:list={[section, shell, 'grid grid-cols-[.72fr_1.28fr] gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-10']}>
      <header data-reveal class="max-w-[470px]">
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{copy.vision.title}</h2>
        <p class="mb-0 text-lg text-copy-muted max-[720px]:text-base">{copy.vision.description}</p>
      </header>
      <div class="grid grid-cols-2 gap-px overflow-hidden rounded-panel border border-line bg-line max-[620px]:grid-cols-1">
        {copy.vision.items.map((item, index) => {
          const Icon = principleIcons[index]
          return (
            <article data-reveal data-principle-card style={`--reveal-delay: ${index * 70}ms`} class:list={['bg-panel p-7', index === 0 ? 'row-span-2 min-h-[330px] max-[620px]:row-auto max-[620px]:min-h-0' : 'min-h-[164px]']}>
              <Icon class="mb-8 text-brand" size={25} stroke-width={1.6} aria-hidden="true" />
              <h3 class="mb-2 text-xl font-[650]">{item.title}</h3>
              <p class="mb-0 text-sm leading-[1.7] text-copy-muted">{item.body}</p>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section class:list={[section, shell]} id="releases">
    <div class="grid grid-cols-[.75fr_1.25fr] gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-10">
      <header data-reveal class="max-w-[470px]">
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{copy.releases.title}</h2>
        <p class="mb-0 text-copy-muted">{copy.releases.description}</p>
      </header>
      <div data-reveal class="border-t border-line">
        {releaseProjects.map(project => {
          const projectMetrics = metrics[project.id]
          return (
            <article class="grid min-h-[112px] grid-cols-[48px_1fr_auto_42px] items-center gap-4 border-b border-line max-[520px]:grid-cols-[42px_1fr_auto]">
              <img class="size-11 object-contain max-[520px]:size-9" src={project.data.logo} width="44" height="44" alt="" />
              <div>
                <h3 class="mb-1 text-base font-[650]">{project.data.locales[locale].name}</h3>
                <p class="mb-0 text-xs text-copy-muted">{copy.releases.released} {formatReleaseDate(projectMetrics.releasedAt, numberLocale)}</p>
              </div>
              <strong class="font-mono text-sm">v{projectMetrics.version}</strong>
              <a class:list={[iconControl, 'max-[520px]:hidden']} href={`https://www.npmjs.com/package/${project.data.packageName}`} aria-label={`${copy.releases.viewPackage}: ${project.data.packageName}`} target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="package" data-analytics-project={project.id}>
                <ArrowUpRight size={19} stroke-width={1.8} aria-hidden="true" />
              </a>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-panel">
    <div data-reveal class:list={[shell, 'grid min-h-[260px] grid-cols-[72px_1fr_auto] items-center gap-8 py-12 max-[820px]:grid-cols-[58px_1fr] max-[620px]:grid-cols-1']}>
      <img class="size-[72px] rounded-panel border border-line bg-panel-soft p-2.5 max-[820px]:size-[58px]" src="/logo.svg" width="72" height="72" alt="" />
      <div>
        <h2 class="mb-3 text-[34px] font-[670] max-[620px]:text-[30px]">{copy.collaboration.title}</h2>
        <p class="mb-0 max-w-[650px] text-copy-muted">{copy.collaboration.description}</p>
      </div>
      <a class:list={[buttonSecondary, 'max-[820px]:col-start-2 max-[820px]:w-fit max-[620px]:col-auto']} href="https://github.com/sonofmagic/weapp.dev" target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="collaboration">
        <GitFork size={18} stroke-width={1.9} aria-hidden="true" />
        {copy.collaboration.action}
      </a>
    </div>
  </section>
</main>
<script is:inline>
  (() => {
    const proofs = [...document.querySelectorAll('[data-scroll-proof]')]
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
    if (!proofs.length) return

    const resetProofs = () => {
      proofs.forEach((proof) => {
        proof.style.removeProperty('--proof-opacity')
        proof.style.removeProperty('--proof-rotate')
        proof.style.removeProperty('--proof-lift')
        proof.style.removeProperty('--proof-scale')
      })
    }

    const syncProofs = () => {
      const start = innerHeight * 0.92
      const end = innerHeight * 0.18
      const distance = Math.max(1, start - end)

      proofs.forEach((proof) => {
        const progress = Math.min(1, Math.max(0, (start - proof.getBoundingClientRect().top) / distance))
        proof.style.setProperty('--proof-opacity', String(0.62 + progress * 0.38))
        proof.style.setProperty('--proof-rotate', `${18 - progress * 18}deg`)
        proof.style.setProperty('--proof-lift', `${(1 - progress) * 3.5}rem`)
        proof.style.setProperty('--proof-scale', String(0.84 + progress * 0.16))
      })
    }

    const syncMotion = () => {
      const enabled = !motionQuery.matches
      document.documentElement.toggleAttribute('data-project-proof-motion', enabled)
      if (enabled) syncProofs()
      else resetProofs()
    }

    let scheduled = false
    const requestSync = () => {
      if (scheduled) return
      scheduled = true
      window.setTimeout(() => {
        scheduled = false
        if (!motionQuery.matches) syncProofs()
      }, 16)
    }

    addEventListener('scroll', requestSync, { passive: true })
    addEventListener('resize', requestSync)
    motionQuery.addEventListener('change', syncMotion)
    syncMotion()
  })()
</script>
