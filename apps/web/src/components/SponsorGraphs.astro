---
import { donationCopy } from '../i18n/donation'
import type { Locale } from '../types/project'
import type { SponsorGraphData } from '../lib/sponsors'
interface Props { locale: Locale; graph: SponsorGraphData }
const { locale, graph } = Astro.props
const graphNameOverrides: Record<string, string> = locale === 'zh-CN' ? {
  'fund:core': '核心维护',
  'fund:contributors': '贡献者基金',
  'fund:ecosystem': '周边开源',
  'ledger:net': '未指定项目的净额',
} : { 'ledger:net': 'General donations (net)' }
const nodeKindLabels = locale === 'zh-CN' ? { sponsor: '赞助者', project: '项目', fund: '资金桶', site: '站点' } : { sponsor: 'Sponsor', project: 'Project', fund: 'Fund', site: 'Site' }
const localizedGraph = {
  ...graph,
  nodes: graph.nodes.map(node => ({ ...node, name: graphNameOverrides[node.id] ?? node.name })),
  buckets: graph.buckets.map(bucket => ({ ...bucket, name: graphNameOverrides[bucket.id] ?? bucket.name })),
}
const labels = locale === 'zh-CN'
  ? { flow: '资金流', relation: '关系图谱', graphRegion: '赞助图谱', flowHelp: '当前公开快照不含金额；公开账本提供金额后会显示实际数值，当前展示分配比例。', relationHelp: '可筛选赞助者、项目、资金桶和站点。公开快照未提供赞助的项目归属，因此不展示赞助者到项目的连线。', summary: '当前快照：{nodes} 个节点，{edges} 条连接。', all: '全部', reset: '重置视图', table: '可读数据', nodes: '节点列表', edges: '连接列表', kind: '类型', node: '节点', source: '起点', target: '终点', edgeType: '连接类型', funding: '资金流', display: '展示关系', details: '节点详情', open: '打开链接', error: '图表运行时暂时不可用，请使用下方可读数据。' }
  : { flow: 'Funding flow', relation: 'Relationship graph', graphRegion: 'Sponsor graphs', flowHelp: 'The current public snapshot contains no amounts; actual values appear when the public ledger includes them. This view shows allocation shares.', relationHelp: 'Filter sponsors, projects, fund buckets and sites. The public snapshot has no project attribution, so sponsors are not linked to projects.', summary: 'Current snapshot: {nodes} nodes, {edges} connections.', all: 'All', reset: 'Reset view', table: 'Accessible data', nodes: 'Nodes', edges: 'Connections', kind: 'Type', node: 'Node', source: 'From', target: 'To', edgeType: 'Connection type', funding: 'Funding flow', display: 'Display relationship', details: 'Node details', open: 'Open link', error: 'The chart runtime is unavailable. Use the accessible data below.' }
---
<sponsor-graphs role="region" aria-label={labels.graphRegion} class="sponsor-graphs" data-sponsor-graphs data-locale={locale} data-graph={JSON.stringify(localizedGraph)} aria-busy="false">
  <section class="sponsor-graph-card" data-graph-card="flow" aria-labelledby="sponsor-flow-title" aria-describedby="sponsor-flow-help sponsor-flow-summary">
    <header><div><h2 id="sponsor-flow-title">{labels.flow}</h2><p id="sponsor-flow-help">{labels.flowHelp} {donationCopy[locale].allocation}</p></div></header>
    <p class="sponsor-graph-loading" data-graph-loading role="status" aria-live="polite" hidden>{locale === 'zh-CN' ? '正在加载图表…' : 'Loading chart…'}</p>
    <p class="sponsor-graph-note" data-no-js-note>{locale === 'zh-CN' ? '当前显示资金桶分配表；启用 JavaScript 后可加载交互式资金流图。' : 'The allocation table is shown here. Enable JavaScript to load the interactive funding flow.'}</p>
    <div class="sponsor-chart" data-chart="flow" hidden role="img" aria-label={labels.flow} aria-describedby="sponsor-flow-help sponsor-flow-summary"></div>
    <p id="sponsor-flow-summary" class="sr-only">{locale === 'zh-CN' ? `当前展示 ${localizedGraph.buckets.length} 个资金桶及其分配比例。` : `The current view shows ${localizedGraph.buckets.length} funding buckets and their allocation shares.`}</p>
    <p class="sponsor-graph-error" data-graph-error hidden role="status" aria-live="polite">{labels.error} <button type="button" data-graph-retry aria-label={`${locale === 'zh-CN' ? '重试' : 'Retry'}：${labels.flow}`}>{locale === 'zh-CN' ? '重试图表' : 'Retry charts'}</button></p>
    <details open><summary>{labels.table}</summary><table><caption class="sr-only">{locale === 'zh-CN' ? '资金桶分配比例' : 'Funding bucket allocation shares'}</caption><thead><tr><th scope="col">{locale === 'zh-CN' ? '资金桶' : 'Bucket'}</th><th scope="col">{locale === 'zh-CN' ? '比例' : 'Share'}</th></tr></thead><tbody>{localizedGraph.buckets.map(bucket => <tr><th scope="row">{bucket.name}</th><td>{bucket.share}%</td></tr>)}</tbody></table></details>
  </section>
  <section class="sponsor-graph-card" data-graph-card="relation" aria-labelledby="sponsor-relation-title" aria-describedby="sponsor-relation-help sponsor-relation-summary">
    <header><div><h2 id="sponsor-relation-title">{labels.relation}</h2><p id="sponsor-relation-help">{labels.relationHelp}</p></div><button type="button" data-reset disabled aria-controls="sponsor-relation-chart">{labels.reset}</button></header>
    <div class="sponsor-graph-tools" role="toolbar" aria-label={labels.relation} aria-describedby="sponsor-relation-summary"><input type="search" disabled aria-label={locale === 'zh-CN' ? '搜索节点' : 'Search nodes'} aria-controls="sponsor-relation-chart" data-search placeholder={locale === 'zh-CN' ? '搜索节点' : 'Search nodes'} /><select data-kind disabled aria-label={locale === 'zh-CN' ? '按节点类型筛选' : 'Filter by node type'} aria-controls="sponsor-relation-chart"><option value="">{labels.all}</option><option value="sponsor">{locale === 'zh-CN' ? '赞助者' : 'Sponsors'}</option><option value="project">{locale === 'zh-CN' ? '项目' : 'Projects'}</option><option value="fund">{locale === 'zh-CN' ? '资金桶' : 'Funds'}</option><option value="site">{locale === 'zh-CN' ? '站点' : 'Sites'}</option></select></div>
    <p class="sponsor-graph-note" data-no-js-note>{locale === 'zh-CN' ? '当前显示完整节点和连接列表；启用 JavaScript 后可搜索、筛选并聚焦节点。' : 'Complete node and connection lists are shown here. Enable JavaScript to search, filter and focus nodes.'}</p>
    <div id="sponsor-relation-chart" class="sponsor-chart" data-chart="relation" hidden role="img" aria-label={labels.relation} aria-describedby="sponsor-relation-help sponsor-relation-summary"></div>
    <p class="sponsor-graph-status" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <p id="sponsor-relation-summary" class="sponsor-graph-summary" data-summary>{labels.summary.replace('{nodes}', String(localizedGraph.nodes.length)).replace('{edges}', String(localizedGraph.edges.length + localizedGraph.relationEdges.length))}</p>
    <aside aria-label={labels.details} class="sponsor-node-details" data-node-details hidden role="status" aria-live="polite"><strong data-node-name></strong><span data-node-kind></span><a data-node-link target="_blank" rel="noopener noreferrer" hidden>{labels.open}</a></aside>
    <p class="sponsor-graph-error" data-graph-error hidden role="status" aria-live="polite">{labels.error} <button type="button" data-graph-retry aria-label={`${locale === 'zh-CN' ? '重试' : 'Retry'}：${labels.relation}`}>{locale === 'zh-CN' ? '重试图表' : 'Retry charts'}</button></p>
    <details open>
      <summary>{labels.table}</summary>
      <h3>{labels.nodes}</h3>
      <table><caption class="sr-only">{locale === 'zh-CN' ? '赞助图谱节点列表' : 'Sponsor graph node list'}</caption><thead><tr><th scope="col">{labels.node}</th><th scope="col">{labels.kind}</th></tr></thead><tbody>{localizedGraph.nodes.map(node => <tr><th scope="row"><button type="button" data-node-id={node.id} aria-label={`${node.name} · ${nodeKindLabels[node.kind]}`} disabled>{node.name}</button></th><td>{nodeKindLabels[node.kind]}</td></tr>)}</tbody></table>
      <h3>{labels.edges}</h3>
      <table><caption class="sr-only">{locale === 'zh-CN' ? '赞助图谱连接列表' : 'Sponsor graph connection list'}</caption><thead><tr><th scope="col">{labels.source}</th><th scope="col">{labels.target}</th><th scope="col">{labels.edgeType}</th></tr></thead><tbody>{[...localizedGraph.edges, ...localizedGraph.relationEdges].map(edge => <tr><th scope="row">{localizedGraph.nodes.find(node => node.id === edge.source)?.name ?? edge.source}</th><td>{localizedGraph.nodes.find(node => node.id === edge.target)?.name ?? edge.target}</td><td>{edge.label === 'display' ? labels.display : labels.funding}</td></tr>)}</tbody></table>
    </details>
  </section>
</sponsor-graphs>
<script>
  import type { EChartsType } from 'echarts/core'
  import type { SponsorGraphData } from '../lib/sponsors'

  class SponsorGraphs extends HTMLElement {
    private connection?: AbortController
    private cleanup?: () => void

    async connectedCallback() {
      if (this.connection) return
      const connection = new AbortController()
      this.connection = connection
      const { signal } = connection
      const charts: EChartsType[] = []
      const chartElements = [...this.querySelectorAll<HTMLElement>('[data-chart]')]
      const controls = [...this.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>('input, select, button')]
      const search = this.querySelector<HTMLInputElement>('[data-search]')!
      const kindSelect = this.querySelector<HTMLSelectElement>('[data-kind]')!
      const details = this.querySelector<HTMLElement>('[data-node-details]')!
      this.setAttribute('aria-busy', 'true')
      this.querySelectorAll<HTMLElement>('[data-graph-loading]').forEach(loading => { loading.hidden = false })
      this.querySelectorAll<HTMLElement>('[data-graph-error]').forEach(error => { error.hidden = true })
      this.cleanup = () => charts.forEach(chart => chart.dispose())

      try {
        if ('IntersectionObserver' in window) {
          await new Promise<void>((resolve) => {
            const observer = new IntersectionObserver((entries) => {
              if (entries.some(entry => entry.isIntersecting)) {
                observer.disconnect()
                resolve()
              }
            }, { rootMargin: '600px 0px' })
            observer.observe(this)
            signal.addEventListener('abort', () => {
              observer.disconnect()
              resolve()
            }, { once: true })
          })
        }
        if (signal.aborted) return
        const [{ init, use }, { GraphChart, SankeyChart }, { DataZoomComponent, LegendComponent, TooltipComponent }, { CanvasRenderer }, { LabelLayout }] = await Promise.all([
          import('echarts/core'), import('echarts/charts'), import('echarts/components'), import('echarts/renderers'), import('echarts/features'),
        ])
        if (signal.aborted) return
        use([GraphChart, SankeyChart, DataZoomComponent, LegendComponent, TooltipComponent, CanvasRenderer, LabelLayout])
        const graph: SponsorGraphData = JSON.parse(this.dataset.graph || '{}')
        const reduce = matchMedia('(prefers-reduced-motion: reduce)')
        const zh = this.dataset.locale === 'zh-CN'
        const kindLabels = zh ? { sponsor: '赞助者', project: '项目', fund: '资金桶', site: '站点' } : { sponsor: 'Sponsor', project: 'Project', fund: 'Fund', site: 'Site' }
        chartElements.forEach(element => { element.hidden = false })
        this.querySelectorAll<HTMLElement>('[data-graph-loading]').forEach(loading => { loading.hidden = true })
        this.querySelectorAll<HTMLElement>('[data-no-js-note]').forEach(note => { note.hidden = true })
        const flow = init(this.querySelector<HTMLElement>('[data-chart="flow"]')!)
        charts.push(flow)
        const relation = init(this.querySelector<HTMLElement>('[data-chart="relation"]')!)
        charts.push(relation)
        const chartStyle = () => {
          const style = getComputedStyle(this)
          return {
            color: [style.getPropertyValue('--accent').trim(), '#6e8f82', '#8798a5', '#a4a4ad'],
            textStyle: { color: style.getPropertyValue('--text').trim(), fontFamily: style.getPropertyValue('--font-sans').trim() },
          }
        }
        const labelStyle = () => ({ color: chartStyle().textStyle.color, textBorderWidth: 0 })
        const names = new Map(graph.nodes.map(node => [node.id, node.name]))
        const renderFlow = () => {
          const narrow = flow.getWidth() < 480
          flow.setOption({ ...chartStyle(), animation: !reduce.matches, tooltip: { renderMode: 'richText', valueFormatter: (value: unknown) => `${value}%` }, series: [{
            type: 'sankey', top: narrow ? 52 : 32, bottom: 18, left: 8, right: narrow ? 112 : 180, nodeWidth: 16,
            label: { ...labelStyle(), width: narrow ? 102 : 170, overflow: 'break' },
            data: graph.nodes.filter(node => node.id.startsWith('fund:') || node.id === 'ledger:net').map(node => ({
              name: node.name,
              ...(node.id === 'ledger:net' ? { label: { position: 'top', align: 'left', width: flow.getWidth() - 16, overflow: 'break' } } : {}),
            })),
            links: graph.edges.filter(edge => edge.source === 'ledger:net').map(edge => ({ source: names.get(edge.source), target: names.get(edge.target), value: edge.value })),
            emphasis: { focus: 'adjacency' }, lineStyle: { color: 'gradient', curveness: 0.5 },
          }] })
        }
        renderFlow()

        let compact = relation.getWidth() < 480
        const compactNodeLimit = 48
        const renderRelation = () => {
          const query = search.value.trim().toLowerCase()
          const nodes = graph.nodes.filter(node => (!kindSelect.value || node.kind === kindSelect.value) && (!query || node.name.toLowerCase().includes(query)))
          const visibleNodes = compact ? nodes.slice(0, compactNodeLimit) : nodes
          const ids = new Set(visibleNodes.map(node => node.id))
          relation.setOption({ ...chartStyle(), animation: !reduce.matches, tooltip: { renderMode: 'richText' }, series: [{
            type: 'graph', layout: compact ? 'none' : 'force', roam: true,
            ...(compact ? { left: '23%', right: '23%', top: '12%', bottom: '22%' } : {}),
            data: visibleNodes.map((node, index) => ({ id: node.id, name: node.name, value: node.value, ...(compact ? { x: index % 2, y: Math.floor(index / 2) } : {}), symbolSize: node.kind === 'sponsor' ? 24 : 32 })),
            links: [...graph.edges, ...graph.relationEdges].filter(edge => ids.has(edge.source) && ids.has(edge.target)).map(edge => ({ source: edge.source, target: edge.target, value: edge.value })),
            force: { repulsion: 120, edgeLength: 90, layoutAnimation: !reduce.matches },
            label: { ...labelStyle(), show: true, position: compact ? 'bottom' : 'right', width: compact ? 110 : 150, overflow: 'truncate' }, labelLayout: { hideOverlap: true }, emphasis: { focus: 'adjacency' },
          }] }, { notMerge: true })
          const limited = visibleNodes.length < nodes.length
          this.querySelector<HTMLElement>('[data-status]')!.textContent = zh
            ? `${visibleNodes.length}${limited ? ` / ${nodes.length}` : ''} 个节点`
            : `${visibleNodes.length}${limited ? ` / ${nodes.length}` : ''} nodes`
          const visibleEdges = [...graph.edges, ...graph.relationEdges].filter(edge => ids.has(edge.source) && ids.has(edge.target)).length
          const summary = this.querySelector<HTMLElement>('[data-summary]')!
          summary.textContent = nodes.length === 0
            ? (zh ? '当前公开快照没有可展示的关系数据。' : 'The current public snapshot has no relationship data to display.')
            : (zh ? `当前筛选：${visibleNodes.length}${limited ? ` / ${nodes.length}` : ''} 个节点，${visibleEdges} 条连接。` : `Current filter: ${visibleNodes.length}${limited ? ` / ${nodes.length}` : ''} nodes, ${visibleEdges} connections.`)
          details.hidden = true
        }
        const selectNode = (id: string | undefined) => {
          const selected = graph.nodes.find(node => node.id === id)
          if (!selected) return
          this.querySelector<HTMLElement>('[data-node-name]')!.textContent = selected.name
          this.querySelector<HTMLElement>('[data-node-kind]')!.textContent = kindLabels[selected.kind]
          const link = this.querySelector<HTMLAnchorElement>('[data-node-link]')!
          link.removeAttribute('href')
          link.setAttribute('aria-label', zh ? `打开链接：${selected.name}` : `Open link: ${selected.name}`)
          link.hidden = !selected.url
          if (selected.url) link.href = selected.url
          details.hidden = false
          relation.dispatchAction({ type: 'downplay', seriesIndex: 0 })
          relation.dispatchAction({ type: 'highlight', seriesIndex: 0, name: selected.name })
        }
        relation.on('click', params => {
          if (params.dataType === 'node') selectNode((params.data as { id?: string })?.id)
        })
        this.querySelectorAll<HTMLButtonElement>('[data-node-id]').forEach(button => {
          button.addEventListener('click', () => {
            search.value = ''
            kindSelect.value = ''
            renderRelation()
            selectNode(button.dataset.nodeId)
          }, { signal })
        })
        renderRelation()
        search.addEventListener('input', renderRelation, { signal })
        kindSelect.addEventListener('change', renderRelation, { signal })
        this.querySelector<HTMLButtonElement>('[data-reset]')!.addEventListener('click', () => {
          search.value = ''
          kindSelect.value = ''
          renderRelation()
          search.focus()
        }, { signal })
        reduce.addEventListener('change', () => {
          flow.setOption({ animation: !reduce.matches })
          renderRelation()
        }, { signal })
        const resize = () => {
          if (document.hidden) return
          charts.forEach(chart => chart.resize())
          renderFlow()
          const nextCompact = relation.getWidth() < 480
          if (compact !== nextCompact) {
            compact = nextCompact
            renderRelation()
          }
        }
        const observer = new ResizeObserver(resize)
        chartElements.forEach(element => observer.observe(element))
        const visibility = () => {
          charts.forEach(chart => {
            if (document.hidden) chart.getZr().animation.pause()
            else chart.getZr().animation.resume()
          })
          resize()
        }
        document.addEventListener('visibilitychange', visibility, { signal })
        const themeObserver = new MutationObserver(() => {
          charts.forEach(chart => chart.setOption({ ...chartStyle(), series: [{ label: labelStyle() }] }))
        })
        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
        this.cleanup = () => { observer.disconnect(); themeObserver.disconnect(); charts.forEach(chart => chart.dispose()) }
        visibility()
        controls.forEach(control => { control.disabled = false })
        this.dataset.ready = 'true'
      } catch {
        if (signal.aborted) return
        this.cleanup?.()
        this.cleanup = undefined
        connection.abort()
        if (this.connection === connection) this.connection = undefined
        this.setAttribute('aria-busy', 'false')
        chartElements.forEach(element => { element.hidden = true })
        this.querySelectorAll<HTMLElement>('[data-graph-loading]').forEach(loading => { loading.hidden = true })
        this.querySelectorAll<HTMLDetailsElement>('details').forEach(table => { table.open = true })
        this.querySelectorAll<HTMLElement>('[data-graph-error]').forEach(error => { error.hidden = false })
        this.querySelectorAll<HTMLButtonElement>('[data-graph-retry]').forEach(button => {
          button.disabled = false
          button.onclick = () => { button.disabled = true; window.location.reload() }
        })
        this.querySelector<HTMLButtonElement>('[data-graph-retry]')?.focus({ preventScroll: true })
      } finally {
        if (this.connection === connection) this.setAttribute('aria-busy', 'false')
      }
    }

    disconnectedCallback() {
      this.connection?.abort()
      this.connection = undefined
      this.cleanup?.()
      this.cleanup = undefined
      delete this.dataset.ready
      this.setAttribute('aria-busy', 'false')
      this.querySelectorAll<HTMLElement>('[data-chart], [data-node-details]').forEach(element => { element.hidden = true })
      this.querySelectorAll<HTMLElement>('[data-graph-loading]').forEach(loading => { loading.hidden = true })
      this.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>('input, select, button').forEach(control => { control.disabled = true })
    }
  }
  if (!customElements.get('sponsor-graphs')) customElements.define('sponsor-graphs', SponsorGraphs)
</script>
<style>
  .sponsor-graphs [hidden] { display:none; }
  .sponsor-graphs { display:grid; gap:1.25rem; }
  .sponsor-graph-card { padding:clamp(1rem, 3vw, 2rem); border:1px solid var(--border); border-radius:20px; background:var(--surface); }
  .sponsor-graph-card header { display:flex; justify-content:space-between; gap:1rem; align-items:start; }
  .sponsor-graph-card header > button { flex:0 0 auto; min-width:5.5rem; white-space:nowrap; }
  .sponsor-graph-card h2 { margin:0 0 .5rem; font-size:1.5rem; }
  .sponsor-graph-card header p:last-child { margin:0; color:var(--muted); font-size:.9rem; }
  .sponsor-graph-kicker { margin:0 0 .5rem; color:var(--accent); font:650 .75rem/1 var(--font-sans); }
  .sponsor-chart { width:100%; height:360px; min-height:360px; margin-top:1rem; }
  .sponsor-graph-loading { margin:1rem 0 0; color:var(--muted); font:650 .78rem/1.4 var(--font-sans); }
  .sponsor-graph-note { margin:1rem 0 0; padding:.65rem .75rem; border-left:1px solid var(--accent); color:var(--muted); font-size:.85rem; }
  .sponsor-graph-tools { display:flex; gap:.75rem; margin-top:1rem; }
  .sponsor-graph-tools input,.sponsor-graph-tools select,.sponsor-graph-card button { min-height:2.75rem; border-radius:12px; border:1px solid var(--border); padding:.5rem .7rem; background:var(--surface); color:var(--text); }
  .sponsor-graph-card summary { min-height:44px; align-content:center; cursor:pointer; }
  .sponsor-graph-card header > div { min-width:0; }
  .sponsor-graph-card select { max-width:100%; }
  .sponsor-graph-tools input { flex:1; min-width:0; }
  .sponsor-graph-card { min-width:0; }
  .sponsor-graph-card button[data-node-id] { text-align:left; overflow-wrap:anywhere; max-width:100%; }
  .sponsor-graph-card details { margin-top:1rem; border-top:1px solid var(--border); padding-top:.75rem; }
  .sponsor-graph-card details h3 { margin:1rem 0 .5rem; font-size:.9rem; }
  .sponsor-graph-card table { width:100%; margin-top:.75rem; border-collapse:collapse; text-align:left; font-size:.9rem; }
  .sponsor-graph-card table:has(th:nth-child(2):last-child) th:first-child { width:65%; }
  .sponsor-graph-card table:has(th:nth-child(2):last-child) td:last-child { white-space:nowrap; }
  .sponsor-graph-card th,.sponsor-graph-card td { overflow-wrap:anywhere; padding:.6rem .4rem; border-bottom:1px solid var(--border); }
  .sponsor-graph-status { color:var(--muted); font-size:.8rem; }
  .sponsor-graph-summary { margin:.35rem 0 0; color:var(--muted); font-size:.82rem; }
  .sponsor-node-details { display:flex; flex-wrap:wrap; align-items:center; gap:.6rem; margin-top:.75rem; padding:.75rem; border:1px solid var(--border); background:var(--surface-soft); font-size:.85rem; }
  .sponsor-node-details span { color:var(--muted); font:650 .72rem/1 var(--font-sans); text-transform:uppercase; }
  .sponsor-node-details a { color:var(--accent); font-weight:650; }
  .sponsor-graph-error { margin:1rem 0 0; color:var(--muted); font-size:.85rem; }
  .sponsor-graph-error button { margin-left:.5rem; border:1px solid currentColor; padding:.35rem .6rem; color:inherit; font:650 .78rem/1 var(--font-sans); }
  .sponsor-graph-error button:hover,.sponsor-graph-error button:focus-visible { background:var(--panel-soft); }
  @media (max-width:720px) { .sponsor-graph-card header { flex-wrap:wrap; } .sponsor-graph-card { padding:1rem; } .sponsor-chart { height:300px; min-height:300px; } .sponsor-graph-tools { flex-direction:column; } }
</style>
