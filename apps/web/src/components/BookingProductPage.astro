---
import { ArrowRight, CalendarDays } from '@lucide/astro'
import type { Locale } from '../types/project'
import { bookingPage } from '../lib/booking'
import { buttonPrimary, buttonSecondary, pageTitle, section, sectionTitle, shell } from '../styles/classes'

interface Props { locale: Locale }
const { locale } = Astro.props
const copy = bookingPage(locale)
---

<main id="main-content" class="booking-product">
  <section class:list={[section, shell, 'booking-hero']} aria-labelledby="booking-title">
    <div>
      <h1 id="booking-title" class={pageTitle}>weapp-booking</h1>
      <p class="booking-tagline">{copy.heading}</p>
      <p class="booking-lead">{copy.lead}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class={buttonPrimary} href={copy.contactPath} data-analytics-event="navigate_section" data-analytics-section="booking_contact">{copy.action}<ArrowRight size={18} aria-hidden="true" /></a>
        <a class={buttonSecondary} href="#scope">{copy.scopeAction}</a>
      </div>
    </div>
    <aside class="booking-status" aria-labelledby="booking-status-title">
      <CalendarDays class="text-brand" size={32} stroke-width={1.6} aria-hidden="true" />
      <h2 id="booking-status-title">{copy.status}</h2>
      <p>{copy.statusDetail}</p>
    </aside>
  </section>

  <section class="bg-panel" aria-labelledby="workflow-title">
    <div class:list={[section, shell]}>
      <h2 id="workflow-title" class={sectionTitle}>{copy.workflowTitle}</h2>
      <p class="booking-lead">{copy.workflowLead}</p>
      <ol class="booking-workflow">
        {copy.workflow.map(step => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}
      </ol>
    </div>
  </section>

  <section class:list={[section, shell]} id="scope" aria-labelledby="scope-title">
    <div class="booking-section-intro"><h2 id="scope-title" class={sectionTitle}>{copy.scopeTitle}</h2><p>{copy.scopeLead}</p></div>
    <dl class="booking-details">
      {copy.capabilities.map(item => <div><dt>{item.title}</dt><dd>{item.body}</dd></div>)}
    </dl>
  </section>

  <section class="bg-panel-soft" id="delivery" aria-labelledby="delivery-title">
    <div class:list={[section, shell]}>
      <h2 id="delivery-title" class={sectionTitle}>{copy.deliveryTitle}</h2>
      <dl class="booking-details">
        {copy.delivery.map(item => <div><dt>{item.title}</dt><dd>{item.body}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class:list={[section, shell]} id="deployment" aria-labelledby="deployment-title">
    <h2 id="deployment-title" class={sectionTitle}>{copy.deploymentTitle}</h2>
    <dl class="booking-details">
      {copy.deployment.map(item => <div><dt>{item.title}</dt><dd>{item.body}</dd></div>)}
    </dl>
    <aside class="booking-acceptance" aria-labelledby="acceptance-title"><h3 id="acceptance-title">{copy.acceptanceTitle}</h3><p>{copy.acceptanceBody}</p></aside>
  </section>

  <section class="bg-panel" id="license" aria-labelledby="license-title">
    <div class:list={[section, shell]}>
      <h2 id="license-title" class={sectionTitle}>{copy.licenseTitle}</h2>
      <dl class="booking-details">
        {copy.license.map(item => <div><dt>{item.title}</dt><dd>{item.body}</dd></div>)}
      </dl>
      <div class="booking-future"><h3>{copy.futureTitle}</h3><p>{copy.futureBody}</p></div>
    </div>
  </section>

  <section class:list={[section, shell]} id="consultation" aria-labelledby="consultation-title">
    <h2 id="consultation-title" class={sectionTitle}>{copy.contactTitle}</h2>
    <p class="booking-lead">{copy.contactBody}</p>
    <a class:list={[buttonPrimary, 'mt-8']} href={copy.contactPath} data-analytics-event="navigate_section" data-analytics-section="booking_contact">{copy.action}<ArrowRight size={18} aria-hidden="true" /></a>
  </section>
</main>

<style>
  .booking-hero { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .7fr); gap: 4rem; align-items: center; }
  .booking-tagline { margin-block: 1.5rem; max-width: 22ch; font-size: clamp(1.75rem, 3vw, 2.6rem); font-weight: 600; line-height: 1.28; text-wrap: balance; }
  .booking-lead { max-width: 70ch; margin-bottom: 0; color: var(--muted); font-size: 1.125rem; line-height: 1.7; }
  .booking-status { padding: 2rem; border-radius: 20px; background: var(--surface-soft); }
  .booking-status h2 { margin-block: 1.5rem .75rem; font-size: 1.35rem; font-weight: 650; line-height: 1.4; }
  .booking-status p, .booking-workflow p, .booking-details dd, .booking-section-intro p, .booking-acceptance p, .booking-future p { margin-bottom: 0; color: var(--muted); line-height: 1.75; }
  .booking-workflow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; margin-top: 3.5rem; padding-left: 1.5rem; }
  .booking-workflow li { padding-left: .4rem; }
  .booking-workflow li::marker { color: var(--accent); font-weight: 650; }
  .booking-workflow h3, .booking-acceptance h3, .booking-future h3 { margin-bottom: .75rem; font-size: 1.35rem; font-weight: 650; }
  .booking-section-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .booking-details { margin-top: 3rem; margin-bottom: 0; }
  .booking-details > div { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: 3rem; padding-block: 2rem; border-top: 1px solid var(--border); }
  .booking-details dt { font-size: 1.35rem; font-weight: 650; }
  .booking-details dd { max-width: 70ch; margin-left: 0; }
  .booking-acceptance { margin-top: 2rem; padding: 2rem; border-radius: 20px; background: var(--surface-soft); }
  .booking-acceptance p, .booking-future p { max-width: 75ch; }
  .booking-future { margin-top: 2rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
  @media (max-width: 960px) { .booking-hero { grid-template-columns: 1fr; gap: 2.5rem; } .booking-workflow { grid-template-columns: repeat(2, minmax(0, 1fr)); } .booking-status { max-width: 70ch; } }
  @media (max-width: 720px) { .booking-section-intro, .booking-details > div { grid-template-columns: 1fr; gap: .75rem; } .booking-workflow { grid-template-columns: 1fr; } .booking-section-intro { gap: 0; } .booking-status, .booking-acceptance { padding: 1.5rem; } .booking-lead { font-size: 1rem; } }
</style>
