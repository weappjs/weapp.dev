{
  "name": "@weapp-io/web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsx scripts/prepare-project-assets.ts && astro build && pnpm og:generate && pnpm pages:prepare && tsx scripts/validate-build.ts",
    "pages:prepare": "tsx scripts/prepare-pages-content.ts",
    "check": "astro check && tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "dev": "tsx scripts/prepare-project-assets.ts && astro dev",
    "lint": "eslint .",
    "lint:styles": "stylelint 'src/**/*.css'",
    "metrics": "pnpm --filter @weapp-io/project-catalog metrics",
    "metrics:sync": "pnpm --filter @weapp-io/project-catalog metrics:sync",
    "metrics:update-fallback": "pnpm --filter @weapp-io/project-catalog metrics:sync",
    "og:generate": "tsx scripts/generate-og.ts",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:analytics-live": "WEAPP_ANALYTICS_LIVE_TEST=1 playwright test tests/e2e/analytics-live.spec.ts --project=desktop"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/astro": "1.61.0",
    "@weapp-io/project-catalog": "workspace:*",
    "@weapp-io/site-ui": "workspace:*",
    "astro": "7.4.1",
    "echarts": "6.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "node-html-parser": "9.0.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "weapp-tailwindcss": "5.6.3",
    "wrangler": "4.151.3"
  }
}
