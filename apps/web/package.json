{
  "name": "@weapp.dev/web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm og:generate && pnpm metrics && astro build && tsx scripts/prepare-pages-content.ts && tsx scripts/validate-build.ts",
    "build:pages": "WEAPP_DEPLOY_TARGET=github-pages pnpm build",
    "build:cloudflare": "pnpm build",
    "pages:rewrite": "tsx scripts/rewrite-github-pages-paths.ts",
    "pages:prepare": "tsx scripts/prepare-pages-content.ts",
    "check": "astro check && tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "dev": "astro dev",
    "lint": "eslint .",
    "lint:styles": "stylelint 'src/**/*.css'",
    "metrics": "tsx scripts/generate-metrics.ts",
    "metrics:sync": "tsx scripts/generate-metrics.ts --update-fallback --require-fresh",
    "media:generate": "tsx scripts/generate-media.ts",
    "media:prepare-showcase": "node scripts/prepare-showcase-retail.mjs",
    "media:capture-showcase": "node scripts/capture-showcase.mjs",
    "media:showcase": "tsx scripts/generate-showcase.ts",
    "media:verify-showcase": "pnpm media:verify-home",
    "media:verify-home": "node scripts/verify-home.mjs",
    "metrics:update-fallback": "tsx scripts/generate-metrics.ts --update-fallback",
    "og:generate": "tsx scripts/generate-og.ts",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:analytics-live": "WEAPP_ANALYTICS_LIVE_TEST=1 playwright test tests/e2e/analytics-live.spec.ts --project=desktop"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@lucide/astro": "1.46.0",
    "astro": "7.3.2",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "node-html-parser": "9.0.4",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "weapp-tailwindcss": "5.5.5",
    "wrangler": "4.131.2"
  }
}
