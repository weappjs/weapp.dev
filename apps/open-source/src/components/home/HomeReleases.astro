---
import { ArrowUpRight } from '@lucide/astro'
import type { Locale, ProjectMetricsMap } from '../../types/project'
import type { ProjectEntry } from '../../lib/projects'
import { formatReleaseDate } from '../../lib/metrics'
import { homeSection, iconControl, sectionTitle, shell } from '../../styles/classes'
import { getSiteCopy } from '../../i18n/ui'

interface Props {
  locale: Locale
  projects: ProjectEntry[]
  metrics: ProjectMetricsMap
}

const { locale, projects, metrics } = Astro.props
const copy = getSiteCopy(locale)
const numberLocale = locale === 'zh-CN' ? 'zh-CN' : 'en-US'
---

<section class:list={[homeSection, shell]} id="releases" aria-labelledby="releases-title">
  <div class="grid grid-cols-[.75fr_1.25fr] gap-12 max-[900px]:grid-cols-1 max-[900px]:gap-8">
    <header data-reveal class="max-w-[470px]">
      <h2 id="releases-title" class={sectionTitle}>{copy.releases.title}</h2>
      <p class="mb-0 text-copy-muted">{copy.releases.description}</p>
    </header>
    <div data-reveal class="border-t border-line">
      {projects.map(project => {
        const projectMetrics = metrics[project.id]
        const planned = project.data.status === 'planned'
        const titleId = `release-title-${project.id}`
        const statusId = `release-status-${project.id}`
        return (
          <article class="grid min-h-[96px] grid-cols-[48px_1fr_auto_42px] items-center gap-4 border-b border-line max-[520px]:grid-cols-[42px_1fr_auto]" aria-labelledby={titleId} aria-describedby={statusId}>
            <img class="size-11 object-contain max-[520px]:size-9" src={project.data.logo} width="44" height="44" alt="" loading="lazy" decoding="async" />
            <div>
              <h3 id={titleId} class="mb-1 text-base font-[650]">{project.data.locales[locale].name}</h3>
              <p id={statusId} class="mb-0 text-xs text-copy-muted">{planned ? (locale === 'zh-CN' ? '规划中，尚无公开版本' : 'Planned, no public release yet') : `${copy.releases.released} ${formatReleaseDate(projectMetrics!.releasedAt, numberLocale)}`}</p>
            </div>
            <strong class="font-mono text-sm">{planned ? (locale === 'zh-CN' ? '规划中' : 'Planned') : `v${projectMetrics!.version}`}</strong>
            {!planned ? <a class:list={[iconControl, 'max-[520px]:hidden']} href={project.data.npmUrl} aria-label={`${copy.releases.viewPackage}: ${project.data.packageName}`} target="_blank" rel="noopener noreferrer" data-analytics-event="click_outbound" data-analytics-target="package" data-analytics-project={project.id}>
              <ArrowUpRight size={19} stroke-width={1.8} aria-hidden="true" />
            </a> : <span aria-hidden="true" />}
          </article>
        )
      })}
    </div>
  </div>
</section>
