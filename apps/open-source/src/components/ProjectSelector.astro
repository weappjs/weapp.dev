---
import type { Locale } from '../types/project'
import { ArrowRight, ArrowUpRight } from '@lucide/astro'
import { localizePath, projectPath } from '../i18n/ui'
import type { ProjectEntry } from '../lib/projects'
interface Props { locale: Locale; projects: ProjectEntry[] }
const { locale, projects } = Astro.props
const byId = new Map(projects.map(project => [project.id, project]))
const copy = locale === 'zh-CN' ? {
  eyebrow: 'START HERE', title: '按你现在的工程状态开始', action: '打开项目', docs: '文档', copy: '复制命令', copied: '已复制', copyFailed: '请手动复制',
  planned: '该项目仍在规划中，暂不提供安装命令。',
  paths: [
    { title: '新建小程序工程', body: '从现代 Vite 工程开始，再按需要叠加样式和组件。', ids: ['weapp-vite', 'weapp-tailwindcss', 'varo'] },
    { title: '已有小程序项目', body: '先把样式工作流接进现有项目，不要求重写页面。', ids: ['weapp-tailwindcss'] },
    { title: '需要组件源码和业务 Blocks', body: '从 Varo Registry 安装可编辑源码，再按业务需要组合组件与 Blocks。', ids: ['varo'] },
    { title: '需要本地数据', body: '评估结构化本地存储和离线能力，关注 weapp-sqlite 的规划进展。', ids: ['weapp-sqlite'] },
    { title: '已有 Taro / React 项目', body: '保留 Taro 组件和 API，把开发构建链路切换到 Vite。', ids: ['vite-plugin-taro'] },
  ],
} : {
  eyebrow: 'START HERE', title: 'Start from your current project state', action: 'Open project', docs: 'Docs', copy: 'Copy command', copied: 'Copied', copyFailed: 'Copy manually',
  planned: 'This project is planned; no install command is available yet.',
  paths: [
    { title: 'Starting a new mini-app', body: 'Begin with a modern Vite project, then add styling and components as needed.', ids: ['weapp-vite', 'weapp-tailwindcss', 'varo'] },
    { title: 'Working in an existing mini-app', body: 'Bring the styling workflow into the current project without rewriting pages.', ids: ['weapp-tailwindcss'] },
    { title: 'Choosing component source and Blocks', body: 'Install editable source from the Varo Registry, then compose components and Blocks for your product.', ids: ['varo'] },
    { title: 'Planning local data', body: 'Evaluate structured storage and offline needs while weapp-sqlite is being planned.', ids: ['weapp-sqlite'] },
    { title: 'Already on Taro / React', body: 'Keep Taro components and APIs while moving the development pipeline to Vite.', ids: ['vite-plugin-taro'] },
  ],
}
---
<section class="project-selector" id="start-here" aria-labelledby="start-here-title">
  <header data-reveal><p class="mb-3 font-mono text-xs font-[650] text-brand">{copy.eyebrow}</p><h2 id="start-here-title">{copy.title}</h2></header>
  <div class="project-selector-list">{copy.paths.map((path, index) => { const firstProject = byId.get(path.ids[0]); const commandId = `selector-command-${index}`; const statusId = `selector-status-${index}`; const planned = firstProject && (firstProject.data.status === 'planned' || !firstProject.data.installCommand); const describedBy = planned ? `path-description-${index} ${statusId}` : firstProject?.data.installCommand ? `path-description-${index} ${commandId}` : `path-description-${index}`; return <article data-reveal style={`--reveal-delay:${index * 60}ms`} aria-labelledby={`path-title-${index}`} aria-describedby={describedBy}><span class="project-selector-index">{String(index + 1).padStart(2, '0')}</span><div><h3 id={`path-title-${index}`}>{path.title}</h3><p id={`path-description-${index}`}>{path.body}</p><div class="project-selector-projects">{path.ids.map(id => { const project = byId.get(id); if (!project) return null; return <a href={projectPath(locale, id)} aria-label={`${project.data.locales[locale].name} · ${path.title}`}><img src={project.data.logo} width="24" height="24" alt="" loading="lazy" decoding="async" />{project.data.locales[locale].name}</a> })}</div>{firstProject && (planned ? <p id={statusId} class="project-selector-planned" aria-label={locale === 'zh-CN' ? '项目状态：规划中' : 'Project status: Planned'}>{copy.planned}</p> : <div class="project-selector-command"><span>{locale === 'zh-CN' ? '第一步' : 'First step'}</span><code id={commandId} tabindex="0" aria-label={locale === 'zh-CN' ? '安装命令' : 'Install command'}>{firstProject.data.installCommand}</code><button type="button" disabled data-selector-copy={firstProject.data.installCommand} data-copy-label={copy.copy} data-copied-label={copy.copied} data-copy-failed-label={copy.copyFailed} data-analytics-event="copy_command" data-analytics-project={firstProject.id} aria-label={copy.copy} aria-describedby={commandId}><span data-selector-copy-text role="status" aria-live="polite">{copy.copy}</span></button></div>)}</div><div class="project-selector-actions"><a class="project-selector-action" href={projectPath(locale, path.ids[0])} aria-label={`${copy.action}: ${path.title}`}>{copy.action}<ArrowUpRight size={15} stroke-width={1.8} aria-hidden="true" /></a>{firstProject && <a class="project-selector-action" href={firstProject.data.docsUrl} target="_blank" rel="noopener noreferrer" aria-label={`${copy.docs}: ${path.title}`}>{copy.docs}<ArrowUpRight size={15} stroke-width={1.8} aria-hidden="true" /></a>}</div></article> })}</div>
  <a class="project-selector-all" href={localizePath(locale, '/projects/')}>{locale === 'zh-CN' ? '浏览全部项目' : 'Browse all projects'} <ArrowRight size={16} stroke-width={1.8} aria-hidden="true" /></a>
</section>
<script>
  import { copyCode } from '../scripts/copy-code'

  document.querySelectorAll<HTMLButtonElement>('[data-selector-copy]').forEach((button) => {
    const code = button.parentElement?.querySelector('code')
    if (!code) return
    button.addEventListener('click', async () => {
      const copied = await copyCode(code)
      const label = (copied ? button.dataset.copiedLabel : button.dataset.copyFailedLabel) || ''
      button.setAttribute('aria-label', label)
      const text = button.querySelector<HTMLElement>('[data-selector-copy-text]')
      if (text) text.textContent = label
    })
    button.disabled = false
  })
</script>
<style>
  .project-selector { padding: 2rem; border: 1px solid var(--border); background: var(--surface-soft); }
  .project-selector h2 { max-width: 640px; margin: 0; font: 680 clamp(1.6rem, 3vw, 2.6rem)/1.1 var(--font-display); text-wrap: balance; }
  .project-selector-list { margin-top: 2rem; border-top: 1px solid var(--border); }
  .project-selector-list article { display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; gap: 1rem; align-items: start; padding: 1.2rem 0; border-bottom: 1px solid var(--border); }
  .project-selector-index { color: var(--accent); font: 650 .75rem/1 var(--font-mono); }
  .project-selector h3 { margin: 0 0 .35rem; font-size: 1.05rem; }
  .project-selector p { margin: 0 0 .75rem; color: var(--muted); font-size: .9rem; line-height: 1.6; }
  .project-selector-projects { display:flex; flex-wrap:wrap; gap:.5rem; }
  .project-selector-projects a { display:inline-flex; align-items:center; gap:.4rem; padding:.3rem .5rem; border:1px solid var(--border); color:var(--text); font:650 .75rem/1 var(--font-mono); }
  .project-selector-projects img { width:1.5rem; height:1.5rem; object-fit:contain; }
  .project-selector-command { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; margin-top:.75rem; color:var(--muted); font:650 .7rem/1.4 var(--font-mono); }
  .project-selector-command code { display:inline-block; overflow:auto; max-width:100%; border:1px solid var(--border); padding:.35rem .5rem; color:var(--text); background:var(--surface); font:inherit; white-space:nowrap; }
  .project-selector-command code:focus-visible { outline:3px solid var(--highlight); outline-offset:2px; }
  .project-selector-command button { min-height:2rem; border:1px solid var(--border); padding:.35rem .5rem; color:var(--muted); background:var(--surface); font:650 .7rem/1.4 var(--font-mono); cursor:pointer; }
  .project-selector-command button:enabled:hover,.project-selector-command button:focus-visible { border-color:var(--accent); color:var(--text); }
  .project-selector-command button:disabled { cursor:not-allowed; opacity:.6; }
  .project-selector-planned { margin-top:.75rem !important; color:var(--muted); font:650 .72rem/1.5 var(--font-mono); }
  .project-selector-actions { display: flex; flex-direction: column; align-items: start; }
  .project-selector-action { min-height: 2.75rem; display:inline-flex; gap:.35rem; align-items:center; color:var(--accent); font-size:.82rem; font-weight:650; white-space:nowrap; }
  .project-selector-all { display:inline-flex; gap:.5rem; margin-top:1rem; color:var(--text); font-size:.88rem; font-weight:650; }
  @media (max-width:620px) { .project-selector { padding:1rem; } .project-selector-list article { grid-template-columns:1.75rem minmax(0,1fr); } .project-selector-actions { grid-column:2; flex-direction:row; flex-wrap:wrap; gap:1rem; } }
</style>
