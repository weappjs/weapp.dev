---
interface Props { eyebrow?: string, title: string, description?: string, id?: string }
const { eyebrow, title, description, id } = Astro.props
---
<header data-reveal class="section-intro" id={id}>
  {eyebrow && <p class="section-intro-eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class="section-intro-description">{description}</p>}
</header>
