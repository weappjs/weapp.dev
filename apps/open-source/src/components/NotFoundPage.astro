---
import { ArrowLeft } from '@lucide/astro'
import type { Locale } from '../types/project'
import { localizePath, getSiteCopy } from '../i18n/ui'
import { buttonPrimary, pageTitle, shell } from '../styles/classes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = getSiteCopy(locale).notFound
---

<main id="main-content" class:list={[shell, 'grid min-h-[min(700px,calc(100dvh-64px))] place-items-center py-24 max-[720px]:py-16']}>
  <div data-reveal class="max-w-[800px] text-center">
    <strong class="block font-display text-[clamp(5rem,16vw,10rem)] font-[650] leading-none tracking-[-.04em] text-copy-muted">404</strong>
    <h1 class:list={[pageTitle, "my-5"]}>{copy.title}</h1>
    <p class="mx-auto mb-8 max-w-[540px] text-lg leading-[1.7] text-copy-muted">{copy.description}</p>
    <a class={buttonPrimary} href={localizePath(locale)}>
      <ArrowLeft size={18} stroke-width={1.9} aria-hidden="true" />
      {copy.action}
    </a>
  </div>
</main>
