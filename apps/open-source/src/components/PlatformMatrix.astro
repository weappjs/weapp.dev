---
import type { Locale, ProjectDefinition } from '../types/project'
interface Props { locale: Locale; platforms: ProjectDefinition['platforms']; runtime?: ProjectDefinition['runtime'] }
const { locale, platforms = [], runtime = [] } = Astro.props
const platformLabel = locale === 'zh-CN' ? '平台' : 'Platform'
const runtimeLabel = locale === 'zh-CN' ? '运行时' : 'Runtime'
---
{platforms.length || runtime.length ? <div class="flex flex-wrap gap-2" role="list" aria-label={locale === 'zh-CN' ? '平台与运行时' : 'Platforms and runtimes'}>
  {platforms.map(platform => <span role="listitem" aria-label={`${platformLabel}: ${platform}`} class="inline-flex items-center border border-line px-2.5 py-1.5 font-mono text-xs text-copy-muted">{platform}</span>)}
  {runtime.map(item => <span role="listitem" aria-label={`${runtimeLabel}: ${item}`} class="inline-flex items-center border border-line bg-panel-soft px-2.5 py-1.5 font-mono text-xs text-copy-muted">{item}</span>)}
</div> : null}
