{
  "name": "weapp.dev",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:cloudflare": "pnpm --filter @weapp-io/web build",
    "check": "pnpm check:boundaries && turbo run lint lint:styles check test",
    "dev": "turbo run dev --filter=@weapp-io/web",
    "lint": "turbo run lint lint:styles",
    "metrics": "pnpm --filter @weapp-io/project-catalog metrics",
    "metrics:sync": "pnpm --filter @weapp-io/project-catalog metrics:sync",
    "preview": "pnpm --filter @weapp-io/web preview",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "release:plan": "repo release plan",
    "release:prepare": "repo release ci --mode prepare",
    "release:verify": "pnpm check:boundaries && pnpm --filter weapp check && pnpm --filter weapp lint && pnpm --filter weapp lint:styles && pnpm --filter weapp test && pnpm --filter weapp test:pack",
    "release:build": "pnpm --filter weapp build",
    "test": "turbo run test",
    "prepare": "husky",
    "typecheck": "turbo run check",
    "build:pages": "pnpm --filter @weapp-io/open-source build",
    "dev:pages": "pnpm --filter @weapp-io/open-source dev",
    "preview:pages": "pnpm --filter @weapp-io/open-source preview",
    "check:boundaries": "node scripts/check-boundaries.mjs && vitest run --config scripts/vitest.config.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "repoctl": "5.10.3",
    "stylelint": "17.16.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
