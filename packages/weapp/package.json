{
  "name": "weapp",
  "type": "module",
  "version": "0.3.0",
  "description": "A project-driven mini-app workbench with animated terminal navigation and an offline ecosystem lab.",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://weapp.js.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weappjs/weapp.dev.git",
    "directory": "packages/weapp"
  },
  "bugs": {
    "url": "https://github.com/weappjs/weapp.dev/issues"
  },
  "keywords": [
    "weapp",
    "weappjs",
    "weapp-cli",
    "weapp.js.org",
    "mini-program",
    "mini-app",
    "open-source",
    "navigation",
    "catalog",
    "javascript",
    "ecosystem",
    "vite",
    "taro",
    "vue",
    "react",
    "tailwindcss"
  ],
  "bin": {
    "weapp": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsx scripts/build.ts && tsdown",
    "prepack": "pnpm build",
    "preflight": "tsx scripts/preflight.ts",
    "lint": "eslint src scripts test lab *.ts",
    "lint:styles": "stylelint 'lab/**/*.css'",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && tsx scripts/browser-test.ts",
    "test:pack": "tsx scripts/pack-test.ts",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "open": "10.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/semver": "7.8.0",
    "@weapp-io/project-catalog": "workspace:*",
    "@weapp-io/site-ui": "workspace:*",
    "cross-spawn": "7.0.6",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "semver": "7.8.5",
    "string-width": "7.2.0",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
