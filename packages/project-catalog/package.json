{
  "name": "@weapp/project-catalog",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./types": "./src/types/project.ts",
    "./schemas": "./src/content/schemas.ts",
    "./paths": "./src/paths.ts",
    "./metrics": "./src/lib/metrics.ts",
    "./projects/*": "./src/content/projects/*",
    "./snapshot": "./src/data/project-metrics.fallback.json",
    "./showcases/*": "./src/content/showcases/*"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "metrics": "tsx scripts/generate-metrics.ts",
    "metrics:sync": "tsx scripts/generate-metrics.ts --update-fallback --require-fresh"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
