---
interface Props {
  wordmark: string
}

const { wordmark } = Astro.props
---

<hero-particles class="home-hero-particles" data-hero-particles data-wordmark={wordmark} aria-hidden="true">
  <canvas class="home-hero-particle-canvas"></canvas>
</hero-particles>
<script>
  import { defineHeroParticles } from '../../scripts/hero-particles'

  defineHeroParticles()
</script>
