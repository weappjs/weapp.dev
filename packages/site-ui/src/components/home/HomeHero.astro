---
import { ArrowUpRight, Pause, Play } from '@lucide/astro'
import type { Locale } from '@weapp/project-catalog/types'
import type { HomeProject } from '../../lib/home-projects'
import { shell } from '../../styles/classes'
import { MINIPROGRAM_PATH, MINIPROGRAM_VIEWBOX } from '../../lib/hero-brand'
import HeroParticles from './HeroParticles.astro'

interface RailProject {
  id: string
  data: HomeProject['data']
  stage: HomeProject['stage']
}

interface RailGroup {
  id: string
  label: string
  projects: RailProject[]
}

interface Props {
  locale: Locale
  wordmark: string
  overviewLabel: string
  railLabel: string
  railGroups: RailGroup[]
  constellation: Array<{ id: string, href: string, logo: string, name: string, accent: string, tagline?: string }>
}

const { locale, railGroups, constellation, wordmark, overviewLabel, railLabel } = Astro.props
---

<section class="home-hero" aria-label={overviewLabel}>
  <div class="home-hero-screen">
    <script is:inline>
      document.documentElement.setAttribute('data-hero-cosmos', '')
    </script>
    <HeroParticles wordmark={wordmark} />
    <svg class="home-hero-logo" data-hero-logo viewBox={`0 0 ${MINIPROGRAM_VIEWBOX} ${MINIPROGRAM_VIEWBOX}`} fill="currentColor" fill-rule="evenodd" aria-hidden="true">
      <path d={MINIPROGRAM_PATH} />
    </svg>
    <hero-planets class="home-hero-constellation">
      <span class="home-hero-gridlines" aria-hidden="true"></span>
      <span class="home-hero-orbit" aria-hidden="true"></span>
      <div class="home-hero-orbit-track">
        {constellation.map((mark, index) => {
          const orbitP = ((index + 0.5) / constellation.length).toFixed(4)
          const orbitStyle = `--orbit-t: 80s; --orbit-p: ${orbitP}; --planet-accent: ${mark.accent};`
          return (
            <Fragment>
              <a
                class={`home-hero-tile home-hero-planet home-hero-planet--${mark.id}`}
                href={mark.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={locale === 'zh-CN' ? `打开 ${mark.name} 官方站点` : `Open ${mark.name} official site`}
                aria-describedby={mark.tagline ? `home-planet-purpose-${mark.id}` : undefined}
                data-planet-name={mark.name}
                data-planet-tagline={mark.tagline}
                data-analytics-event="click_outbound"
                data-analytics-target="project_home"
                data-analytics-project={mark.id}
                style={orbitStyle}
              >
                <span class="home-hero-planet-visual" aria-hidden="true">
                  <span class="home-hero-planet-body"></span>
                  <span class="home-hero-planet-face"></span>
                  <img src={mark.logo} width="48" height="48" alt="" decoding="async" />
                </span>
              </a>
              <span class="home-hero-planet-name" style={orbitStyle} aria-hidden="true">{mark.name}</span>
              {mark.tagline && <span class="sr-only" id={`home-planet-purpose-${mark.id}`}>{mark.tagline}</span>}
            </Fragment>
          )
        })}
      </div>
    </hero-planets>
    <h1 id="home-hero-title" class="home-hero-title" aria-label={wordmark}>
      <span class="sr-only">{wordmark}</span>
    </h1>
    <div class="home-hero-spotlight" data-planet-caption aria-hidden="true" hidden>
      <strong data-planet-caption-name></strong>
      <span data-planet-caption-tagline></span>
    </div>
    <button
      class="home-hero-motion"
      type="button"
      data-planet-toggle
      data-pause-label={locale === 'zh-CN' ? '暂停首屏动画' : 'Pause hero animation'}
      data-resume-label={locale === 'zh-CN' ? '继续首屏动画' : 'Resume hero animation'}
      hidden
    >
      <span data-planet-pause-icon aria-hidden="true"><Pause size={16} stroke-width={1.8} /></span>
      <span data-planet-play-icon aria-hidden="true" hidden><Play size={16} stroke-width={1.8} /></span>
      <span data-planet-toggle-label>{locale === 'zh-CN' ? '暂停首屏动画' : 'Pause hero animation'}</span>
    </button>
  </div>

  <nav class:list={[shell, 'home-project-rail']} aria-label={railLabel}>
    {railGroups.map(group => (
      <section class="home-project-rail-group" aria-labelledby={`home-rail-${group.id}`}>
        <h2 id={`home-rail-${group.id}`} class="home-project-rail-title">{group.label}</h2>
        <div class="home-project-rail-items">
          {group.projects.map((project, index) => {
            const content = project.data.locales[locale]
            return (
              <a class="home-project-link" href={project.data.docsUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="click_outbound" data-analytics-target="project_home" data-analytics-project={project.id}>
                <img src={project.data.logo} width="34" height="34" alt="" loading={index === 0 && group.id === 'weapp' ? 'eager' : 'lazy'} fetchpriority={index === 0 && group.id === 'weapp' ? 'high' : undefined} decoding="async" />
                <span class="min-w-0"><strong>{content.name}</strong><small>{project.stage[locale]} / {content.tagline}</small></span>
                <ArrowUpRight class="home-project-arrow" size={17} stroke-width={1.8} aria-hidden="true" />
              </a>
            )
          })}
        </div>
      </section>
    ))}
  </nav>
</section>

<script>
  import { defineHeroPlanets } from '../../scripts/hero-planets'

  defineHeroPlanets()
</script>

<style is:global>
  /* Layout CSS can emit a truncated copy of this name; this file loads later so 0% → 100% survives. */
  @keyframes home-hero-revolve {
    0% {
      --orbit-turn: 0;
    }

    100% {
      --orbit-turn: 1;
    }
  }
</style>
