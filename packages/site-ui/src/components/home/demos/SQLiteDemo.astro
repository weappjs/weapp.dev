---
import type { Locale } from '@weapp-io/project-catalog/types'
import CodePanel from './CodePanel.astro'
import { sqliteCode } from './sqlite'
interface Props { locale: Locale; instance: string }
const { locale } = Astro.props
const zh = locale === 'zh-CN'
---
<div class="home-demo demo-concept" data-demo="sqlite">
  <div class="demo-controls-space"><p class="demo-controls">{zh ? '静态代码示例 · 未运行数据库' : 'Static code example · no database is running'}</p></div>
  <div class="demo-body"><CodePanel parts={sqliteCode(locale)} locale={locale} filename="sqlite.ts" />
  <div class="demo-preview demo-concept-preview">
    <div class="demo-pane-heading">{zh ? '接入前提' : 'Integration prerequisite'}</div>
    <div class="demo-concept-card"><strong>{zh ? '先在 Vite 配置中注册 weappSqlite()' : 'Register weappSqlite() in your Vite configuration first'}</strong><span>{zh ? 'Beta · Web 与微信开发者工具，微信真机待验证' : 'Beta · Web and WeChat DevTools; WeChat devices await validation'}</span></div>
  </div>
  </div>
</div>
