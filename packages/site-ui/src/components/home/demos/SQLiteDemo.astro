---
import type { Locale } from '@weapp/project-catalog/types'
import CodePanel from './CodePanel.astro'
import { sqliteCode } from './sqlite'
interface Props { locale: Locale; instance: string }
const { locale } = Astro.props
const zh = locale === 'zh-CN'
---
<div class="home-demo demo-concept" data-demo="sqlite">
  <div class="demo-controls-space"><p class="demo-controls">{zh ? 'SQL 概念示例 · 未运行数据库' : 'SQL concept · no database is running'}</p></div>
  <div class="demo-body"><CodePanel parts={sqliteCode(locale)} locale={locale} filename="migration.sql" />
  <div class="demo-preview demo-concept-preview">
    <div class="demo-pane-heading">{zh ? '数据边界' : 'Data boundary'}</div>
    <div class="demo-concept-card"><strong>{zh ? '先设计迁移，再确认运行时' : 'Design the migration before confirming the runtime'}</strong><span>{zh ? '规划中 · 不提供生产 API' : 'Planned · no production API'}</span></div>
  </div>
  </div>
</div>
