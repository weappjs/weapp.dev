---
import type { Locale } from '@weapp/project-catalog/types'
import project from '@weapp/project-catalog/projects/vite-plugin-taro.json'
import CodePanel from './CodePanel.astro'
import { migrationCode } from './migration'
interface Props { locale: Locale; instance: string }
const { locale, instance } = Astro.props
const zh = locale === 'zh-CN'
const visuals = [project.visuals.primary, project.visuals.secondary]
---
<migration-demo class="home-demo" data-demo="migration">
  <div class="demo-controls-space">
    <fieldset class="demo-controls" hidden disabled>
      <legend class="sr-only">{zh ? '官方 HMR 截图' : 'Official HMR screenshots'}</legend>
      <div class="demo-segments">{visuals.map((_, index) => <label><input type="radio" name={`${instance}-frame`} value={index} checked={index === 0} /><span>{zh ? (index === 0 ? '更新前' : '更新后') : (index === 0 ? 'Before edit' : 'After edit')}</span></label>)}</div>
      <span data-migration-hmr>{zh ? 'HMR 截图对照' : 'HMR screenshot comparison'}</span>
    </fieldset>
  </div>
  <div class="demo-body">
    <CodePanel parts={migrationCode(locale)} locale={locale} filename="terminal" />
    <div class="demo-preview">
      {visuals.map((visual, index) => <figure class="demo-hmr-frame" hidden={index !== 0}>
        <a href={visual.src} target="_blank" rel="noopener noreferrer" aria-label={zh ? '打开完整 HMR 截图' : 'Open full HMR screenshot'}><img src={visual.src} width={visual.width} height={visual.height} alt={visual.locales[locale].alt} loading="lazy" decoding="async" /></a>
        <figcaption>{visual.locales[locale].caption}</figcaption>
      </figure>)}
    </div>
  </div>
</migration-demo>
<script>
  class MigrationDemo extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return
      const controls = this.querySelector('fieldset')!
      controls.addEventListener('change', () => {
        const selected = Number(this.querySelector<HTMLInputElement>('input:checked')!.value)
        this.querySelectorAll('figure').forEach((figure, index) => { figure.hidden = index !== selected })
      })
      controls.disabled = false
      controls.hidden = false
      this.dataset.ready = 'true'
    }
  }
  if (!customElements.get('migration-demo')) customElements.define('migration-demo', MigrationDemo)
</script>
